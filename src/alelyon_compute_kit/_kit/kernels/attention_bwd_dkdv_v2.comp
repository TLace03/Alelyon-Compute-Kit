#version 450
// Fused attention, backward for dK and dV (attention-v2, 2026-09-27):
//   dV = P^T dO,   dK = scale * dS^T Q,   dS = P o (dP - Delta),
//   dP = dO V^T,   P = exp(scale * Q K^T - LSE) under the causal mask,
//   Delta = rowsum(dO o O)
// the key-row half of FlashAttention-2's backward (attention_bwd_dq_v2.comp is
// the query-row half), for head dimension D = 64 or 128 (a define), within
// 32 KiB of shared memory (28,928 bytes at D = 128). DETERMINISTIC: one
// workgroup owns a block of 64 keys of one (batch, kv head) and sums over every
// query block that can see it, and over every query head that reads this kv
// head, in a fixed order -- no atomics, no second pass.
//
// Everything is computed TRANSPOSED, so the subgroups own key rows: each of
// the four subgroups owns 16 keys, holds their K and V rows as
// cooperative-matrix A operands for the whole kernel, and keeps dK and dV in
// accumulators. Query blocks are BQ = 32 rows (Q and dO staged in padded
// shared rows, with the rows' LSE and Delta), taken 16 queries at a time:
// S^T = K Q^T and dP^T = V dO^T go through a per-subgroup 16 x 16 scratch,
// P^T and dS^T are formed element by element and rounded to bf16, and
// dV += P^T dO, dK += dS^T Q.
//
// dK (times scale) and dV are written as bf16, keys past T not written.
//
// ELEMENT TYPE (2026-09-29): bf16 by default; -DELT_F16=1 builds the same
// kernel over binary16 (fp16) q, k, v and outputs, for the fp16 autocast the
// stage-E step is registered with. Only the cooperative-matrix element type
// (ELT), the rounding of a float to it (f32_to_elt) and, in the backward, the
// decoding of a stored pair (elt_lo / elt_hi) differ; the fp16 ones are exact
// integer routines, so no CONVERSION depends on a device's float controls
// (with -DF16_HW=1 the device's own conversions under declared round-to-
// nearest-even and denormal preservation, the same rule, for the decode; the
// encode is the integer routine in every build, see below). The fp16
// modules' f32 arithmetic is pinned by NoContraction on every float result,
// added after compiling (kernels/no_contraction.py, 2026-09-30): without it
// the driver contracted the two builds' identical arithmetic differently. The
// bf16 modules' preprocessed source is what it was before this switch.
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#ifdef ELT_F16
#define ELT float16_t
#else
#extension GL_EXT_bfloat16 : require
#define ELT bfloat16_t
#endif
#extension GL_EXT_control_flow_attributes : require
#if defined(ELT_F16) && defined(F16_HW)
// HARDWARE BINARY16 CONVERSION (2026-09-29). -DF16_HW=1 declares round to
// nearest even and denormal preservation for 16-bit floats. A device grants
// both only when it reports shaderRoundingModeRTEFloat16 and
// shaderDenormPreserveFloat16, and the host builds these modules only then
// (ffi::attention_f16_hardware). A float16_t conversion is then IEEE's: round
// to nearest even, subnormals kept, an overflow to infinity. That is the
// integer routine's rule in one instruction. Infinities and NaNs keep the
// integer routines' bits, so the two modules agree on every input
// (tests/attention_v2.rs holds them to it, bit for bit).
#extension GL_EXT_spirv_intrinsics : require
spirv_execution_mode(capabilities = [4467], 4462, 16);   // RoundingModeRTE, 16-bit floats
spirv_execution_mode(capabilities = [4464], 4459, 16);   // DenormPreserve, 16-bit floats
#endif

#ifndef SGW
#define SGW 64
#endif
#ifndef D
#define D 128
#endif
#define BKV 64               // keys per workgroup
#define BQ 32                // query rows per staged block
#define NSG 4
#define WG (NSG * SGW)
#define LPR (SGW / 16)       // lanes per tile row in the elementwise phase
#define TPL (16 / LPR)       // tile columns (queries) per lane
#define DW (D / 2)
#define VPR (D / 8)
#define KSV (VPR + 1)        // shared row stride of K, V, Q and dO, in 16-byte words
#define TSV 5                // scratch tile row stride, in vec4 (16 floats + 16 bytes)
#define PTS 3                // P^T / dS^T tile row stride, in 16-byte words
#define LPD (SGW / 8)        // lanes per query row in the Delta phase (8 rows a subgroup)

layout(local_size_x = WG, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer Qb { uint q[]; };
layout(std430, set = 0, binding = 0) readonly buffer Qb4 { uvec4 q4[]; };
layout(std430, set = 0, binding = 1) readonly buffer Kb { uint k[]; };
layout(std430, set = 0, binding = 1) readonly buffer Kb4 { uvec4 k4[]; };
layout(std430, set = 0, binding = 2) readonly buffer Vb { uint v[]; };
layout(std430, set = 0, binding = 2) readonly buffer Vb4 { uvec4 v4[]; };
layout(std430, set = 0, binding = 3) readonly buffer Ob { uint o[]; };
layout(std430, set = 0, binding = 4) readonly buffer DOb { uint dout[]; };
layout(std430, set = 0, binding = 4) readonly buffer DOb4 { uvec4 dout4[]; };
layout(std430, set = 0, binding = 5) readonly buffer Lb { float lse[]; };
layout(std430, set = 0, binding = 6) writeonly buffer DKb { uint dk[]; };
layout(std430, set = 0, binding = 7) writeonly buffer DVb { uint dv[]; };

layout(push_constant) uniform P {
    uint T, H, HKV, causal;
    uint qB, qH, qR;
    uint kB, kH, kR;
    uint vB, vH, vR;
    uint oB, oH, oR;
    uint gB, gH, gR;     // dO
    uint kgB, kgH, kgR;  // dK
    uint vgB, vgH, vgR;  // dV
    float scale;
} p;

#define LOG2E 1.4426950408889634

shared uvec4 sQG[2 * BQ * KSV];     // K then V at the start; then each query block's Q rows and dO rows
shared vec4 sT[NSG * 16 * TSV];     // per subgroup: S^T, then dP^T; at the end each output tile
shared uvec4 sPT[NSG * 16 * PTS];   // per subgroup: P^T, bf16
shared uvec4 sDST[NSG * 16 * PTS];  // per subgroup: dS^T, bf16
shared float sL[BQ];                // the query rows' LSE, base 2
shared float sDl[BQ];               // and their Delta

#ifdef ELT_F16
// binary32 -> binary16, round to nearest even, subnormals kept, an overflow to
// infinity, a NaN quieted with its payload's top bits: integer instructions
// only, so its bits do not depend on the device's float controls
// THE BACKWARD ENCODES WITH THE INTEGER ROUTINE IN EVERY BUILD (2026-10-21). The hardware modules used
// float16_t(x) here. RX 9070 XT driver 32.0.32015.7029 (installed 2026-10-21) fuses an f32 multiply with that
// conversion into one rounding from the exact product, NoContraction or not: f16(p * (dp - delta)) differed from
// the f32-then-f16 result in 124 of 2,000,000 probed values, each one the single rounding, and a bitcast round
// trip did not stop it. dS = P o (dP - Delta) is exactly that expression, so dQ and dK left the integer modules'
// bits. An integer routine has nothing to fuse. The hardware DECODE below is exact and unchanged.
uint f32_to_f16(float x) {
    const uint bits = floatBitsToUint(x);
    const uint sign = (bits >> 16) & 0x8000u;
    const uint a = bits & 0x7FFFFFFFu;
    if (a >= 0x7F800000u) {
        return sign | 0x7C00u | (a > 0x7F800000u ? (0x0200u | ((a >> 13) & 0x03FFu)) : 0u);
    }
    if (a >= 0x477FF000u) return sign | 0x7C00u;       // 65520 and above round to infinity
    if (a >= 0x38800000u) {                              // a normal binary16
        const uint r = a - 0x38000000u;
        uint h = r >> 13;
        const uint rest = r & 0x1FFFu;
        if (rest > 0x1000u || (rest == 0x1000u && (h & 1u) != 0u)) h += 1u;
        return sign | h;
    }
    if (a < 0x33000000u) return sign;                    // below half the smallest subnormal
    const uint e = a >> 23;                              // 102 .. 112
    const uint m = (a & 0x7FFFFFu) | 0x800000u;
    const uint shift = 126u - e;                         // 14 .. 24
    uint h = m >> shift;
    const uint rest = m & ((1u << shift) - 1u);
    const uint half_ulp = 1u << (shift - 1u);
    if (rest > half_ulp || (rest == half_ulp && (h & 1u) != 0u)) h += 1u;
    return sign | h;                                     // 0x0400 when it rounds up to the smallest normal
}

// binary16 -> binary32, exactly (a subnormal becomes a normal binary32)
#ifdef F16_HW
float f16_to_f32(uint h) {
    if ((h & 0x7C00u) == 0x7C00u) {   // an infinity or a NaN: the integer routine's bits
        return uintBitsToFloat(((h & 0x8000u) << 16) | 0x7F800000u | ((h & 0x03FFu) << 13));
    }
    return float(uint16BitsToFloat16(uint16_t(h)));
}
#else
float f16_to_f32(uint h) {
    const uint sign = (h & 0x8000u) << 16;
    const uint e = (h >> 10) & 0x1Fu;
    const uint m = h & 0x03FFu;
    if (e == 0x1Fu) return uintBitsToFloat(sign | 0x7F800000u | (m << 13));
    if (e != 0u) return uintBitsToFloat(sign | ((e + 112u) << 23) | (m << 13));
    if (m == 0u) return uintBitsToFloat(sign);
    const int top = findMSB(m);
    return uintBitsToFloat(sign | (uint(top + 103) << 23) | ((m << uint(23 - top)) & 0x7FFFFFu));
}
#endif
#define f32_to_elt f32_to_f16
#define elt_lo(w) f16_to_f32((w) & 0xFFFFu)
#define elt_hi(w) f16_to_f32((w) >> 16)
#else
uint f32_to_bf16(float x) {
    uint bits = floatBitsToUint(x);
    if ((bits & 0x7F800000u) == 0x7F800000u && (bits & 0x007FFFFFu) != 0u) {
        return (bits >> 16) | 0x0040u;
    }
    uint lsb = (bits >> 16) & 1u;
    return (bits + 0x7FFFu + lsb) >> 16;
}

float bf16_lo(uint w) { return uintBitsToFloat(w << 16); }
float bf16_hi(uint w) { return uintBitsToFloat(w & 0xFFFF0000u); }
#define f32_to_elt f32_to_bf16
#define elt_lo bf16_lo
#define elt_hi bf16_hi
#endif

void main() {
    const uint kblock = gl_WorkGroupID.x;
    const uint hk = gl_WorkGroupID.y;
    const uint b = gl_WorkGroupID.z;
    const uint group = p.H / p.HKV;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint tid = gl_LocalInvocationID.x;
    const uint r = lane / LPR;            // this lane's key within the subgroup's 16
    const uint c0 = (lane % LPR) * TPL;   // its first query column within a 16-query tile
    const uint krow0 = kblock * BKV;
    const uint my_key = krow0 + sg * 16u + r;
    const uint trow = (sg * 16u + r) * TSV;
    const float sl2 = p.scale * LOG2E;

    const uint kbase = b * p.kB + hk * p.kH;
    const uint vbase = b * p.vB + hk * p.vH;
    const bool veckv = ((p.kB | p.kH | p.kR | p.vB | p.vH | p.vR) & 7u) == 0u;
    const bool vecq = ((p.qB | p.qH | p.qR) & 7u) == 0u;
    const bool vecg = ((p.gB | p.gH | p.gR) & 7u) == 0u;

    // K and V of this key block as A operands, staged through sQG (64 rows each in turn)
    coopmat<ELT, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ka[D / 16];
    coopmat<ELT, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> va[D / 16];
    if (veckv) {
        for (uint i = tid; i < BKV * VPR; i += WG) {
            uint rr = i / VPR, c = i % VPR, kr = krow0 + rr;
            sQG[rr * KSV + c] = kr < p.T ? k4[(kbase + kr * p.kR) / 8u + c] : uvec4(0u);
        }
    } else {
        for (uint i = tid; i < BKV * DW; i += WG) {
            uint rr = i / DW, c = i % DW, kr = krow0 + rr;
            sQG[rr * KSV + c / 4u][c % 4u] = kr < p.T ? k[(kbase + kr * p.kR) / 2u + c] : 0u;
        }
    }
    barrier();
    [[unroll]] for (uint kk = 0u; kk < D / 16u; ++kk) {
        coopMatLoad(ka[kk], sQG, (sg * 16u) * KSV + kk * 2u, KSV, gl_CooperativeMatrixLayoutRowMajor);
    }
    barrier();
    if (veckv) {
        for (uint i = tid; i < BKV * VPR; i += WG) {
            uint rr = i / VPR, c = i % VPR, kr = krow0 + rr;
            sQG[rr * KSV + c] = kr < p.T ? v4[(vbase + kr * p.vR) / 8u + c] : uvec4(0u);
        }
    } else {
        for (uint i = tid; i < BKV * DW; i += WG) {
            uint rr = i / DW, c = i % DW, kr = krow0 + rr;
            sQG[rr * KSV + c / 4u][c % 4u] = kr < p.T ? v[(vbase + kr * p.vR) / 2u + c] : 0u;
        }
    }
    barrier();
    [[unroll]] for (uint kk = 0u; kk < D / 16u; ++kk) {
        coopMatLoad(va[kk], sQG, (sg * 16u) * KSV + kk * 2u, KSV, gl_CooperativeMatrixLayoutRowMajor);
    }

    coopmat<float32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> dka[D / 16];
    coopmat<float32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> dva[D / 16];
    [[unroll]] for (uint dd = 0u; dd < D / 16u; ++dd) {
        dka[dd] = coopmat<float32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
        dva[dd] = coopmat<float32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    }

    const uint nqb = (p.T + BQ - 1u) / BQ;
    const uint first = p.causal != 0u ? krow0 / BQ : 0u;   // the first query block that sees a key here
    for (uint gi = 0u; gi < group; ++gi) {
        const uint h = hk * group + gi;
        const uint qbase = b * p.qB + h * p.qH;
        const uint gbase = b * p.gB + h * p.gH;
        for (uint qb = first; qb < nqb; ++qb) {
            const uint qrow0 = qb * BQ;
            barrier();   // every subgroup is done with sQG, sL and sDl (and the V fragments are loaded)
            if (vecq) {
                for (uint i = tid; i < BQ * VPR; i += WG) {
                    uint rr = i / VPR, c = i % VPR, qr = qrow0 + rr;
                    sQG[rr * KSV + c] = qr < p.T ? q4[(qbase + qr * p.qR) / 8u + c] : uvec4(0u);
                }
            } else {
                for (uint i = tid; i < BQ * DW; i += WG) {
                    uint rr = i / DW, c = i % DW, qr = qrow0 + rr;
                    sQG[rr * KSV + c / 4u][c % 4u] = qr < p.T ? q[(qbase + qr * p.qR) / 2u + c] : 0u;
                }
            }
            if (vecg) {
                for (uint i = tid; i < BQ * VPR; i += WG) {
                    uint rr = i / VPR, c = i % VPR, qr = qrow0 + rr;
                    sQG[(BQ + rr) * KSV + c] = qr < p.T ? dout4[(gbase + qr * p.gR) / 8u + c] : uvec4(0u);
                }
            } else {
                for (uint i = tid; i < BQ * DW; i += WG) {
                    uint rr = i / DW, c = i % DW, qr = qrow0 + rr;
                    sQG[(BQ + rr) * KSV + c / 4u][c % 4u] = qr < p.T ? dout[(gbase + qr * p.gR) / 2u + c] : 0u;
                }
            }
            {
                // the block's LSE and Delta: 8 query rows a subgroup, LPD lanes a row
                const uint dr = sg * 8u + lane / LPD;
                const uint dpart = lane % LPD;
                const uint qr = qrow0 + dr;
                float delta = 0.0;
                if (qr < p.T) {
                    const uint ob = (b * p.oB + h * p.oH + qr * p.oR) / 2u;
                    const uint gb = (gbase + qr * p.gR) / 2u;
                    for (uint c = dpart; c < DW; c += LPD) {
                        uint ow = o[ob + c], gw = dout[gb + c];
                        delta += elt_lo(ow) * elt_lo(gw) + elt_hi(ow) * elt_hi(gw);
                    }
                }
                [[unroll]] for (uint off = 1u; off < LPD; off <<= 1u) {
                    delta += subgroupShuffleXor(delta, off);
                }
                if (dpart == 0u) {
                    sDl[dr] = delta;
                    sL[dr] = qr < p.T ? lse[(b * p.H + h) * p.T + qr] * LOG2E : 0.0;
                }
            }
            barrier();

            [[unroll]] for (uint jq = 0u; jq < BQ / 16u; ++jq) {
                // S^T = K Q^T for this subgroup's 16 keys and the chunk's 16 queries
                coopmat<float32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> st =
                    coopmat<float32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
                [[unroll]] for (uint kk = 0u; kk < D / 16u; ++kk) {
                    coopmat<ELT, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> qt;
                    coopMatLoad(qt, sQG, (jq * 16u) * KSV + kk * 2u, KSV, gl_CooperativeMatrixLayoutColumnMajor);
                    st = coopMatMulAdd(ka[kk], qt, st);
                }
                coopMatStore(st, sT, (sg * 16u) * TSV, TSV, gl_CooperativeMatrixLayoutRowMajor);
                subgroupMemoryBarrierShared();
                subgroupBarrier();
                float pt[TPL];
                [[unroll]] for (uint j4 = 0u; j4 < TPL / 4u; ++j4) {
                    vec4 s4 = sT[trow + c0 / 4u + j4];
                    [[unroll]] for (uint e = 0u; e < 4u; ++e) {
                        uint qc = jq * 16u + c0 + j4 * 4u + e;   // query within the block
                        uint query = qrow0 + qc;
                        bool masked = my_key >= p.T || query >= p.T || (p.causal != 0u && my_key > query);
                        pt[j4 * 4u + e] = masked ? 0.0 : exp2(s4[e] * sl2 - sL[qc]);
                    }
                }
                subgroupMemoryBarrierShared();
                subgroupBarrier();   // every lane has read S^T before dP^T lands on it

                // dP^T = V dO^T, then dS^T = P^T o (dP^T - Delta)
                coopmat<float32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> dpt =
                    coopmat<float32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
                [[unroll]] for (uint kk = 0u; kk < D / 16u; ++kk) {
                    coopmat<ELT, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> gt;
                    coopMatLoad(gt, sQG, (BQ + jq * 16u) * KSV + kk * 2u, KSV, gl_CooperativeMatrixLayoutColumnMajor);
                    dpt = coopMatMulAdd(va[kk], gt, dpt);
                }
                coopMatStore(dpt, sT, (sg * 16u) * TSV, TSV, gl_CooperativeMatrixLayoutRowMajor);
                subgroupMemoryBarrierShared();
                subgroupBarrier();
                [[unroll]] for (uint j2 = 0u; j2 < TPL / 2u; ++j2) {
                    uint qc = jq * 16u + c0 + 2u * j2;
                    vec4 d4 = sT[trow + (c0 + 2u * j2) / 4u];
                    uint sub = (c0 + 2u * j2) % 4u;
                    float ds0 = pt[2u * j2] * (d4[sub] - sDl[qc]);
                    float ds1 = pt[2u * j2 + 1u] * (d4[sub + 1u] - sDl[qc + 1u]);
                    uint col = c0 + 2u * j2;   // query column within the tile, even
                    uint at = (sg * 16u + r) * PTS + col / 8u;
                    sPT[at][(col % 8u) / 2u] = f32_to_elt(pt[2u * j2]) | (f32_to_elt(pt[2u * j2 + 1u]) << 16);
                    sDST[at][(col % 8u) / 2u] = f32_to_elt(ds0) | (f32_to_elt(ds1) << 16);
                }
                subgroupMemoryBarrierShared();
                subgroupBarrier();

                // dV += P^T dO and dK += dS^T Q over the chunk's 16 queries
                coopmat<ELT, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> pta;
                coopmat<ELT, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> dsta;
                coopMatLoad(pta, sPT, (sg * 16u) * PTS, PTS, gl_CooperativeMatrixLayoutRowMajor);
                coopMatLoad(dsta, sDST, (sg * 16u) * PTS, PTS, gl_CooperativeMatrixLayoutRowMajor);
                [[unroll]] for (uint dd = 0u; dd < D / 16u; ++dd) {
                    coopmat<ELT, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> gb16;
                    coopMatLoad(gb16, sQG, (BQ + jq * 16u) * KSV + dd * 2u, KSV, gl_CooperativeMatrixLayoutRowMajor);
                    dva[dd] = coopMatMulAdd(pta, gb16, dva[dd]);
                    coopmat<ELT, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> qb16;
                    coopMatLoad(qb16, sQG, (jq * 16u) * KSV + dd * 2u, KSV, gl_CooperativeMatrixLayoutRowMajor);
                    dka[dd] = coopMatMulAdd(dsta, qb16, dka[dd]);
                }
                subgroupMemoryBarrierShared();
                subgroupBarrier();   // the fragments are loaded before the next chunk overwrites the tiles
            }
        }
    }

    // dK (times scale) and dV -> bf16, one 16 x 16 tile at a time
    [[unroll]] for (uint dd = 0u; dd < D / 16u; ++dd) {
        [[unroll]] for (uint which = 0u; which < 2u; ++which) {
            if (which == 0u) {
                coopMatStore(dka[dd], sT, (sg * 16u) * TSV, TSV, gl_CooperativeMatrixLayoutRowMajor);
            } else {
                coopMatStore(dva[dd], sT, (sg * 16u) * TSV, TSV, gl_CooperativeMatrixLayoutRowMajor);
            }
            subgroupMemoryBarrierShared();
            subgroupBarrier();
            if (my_key < p.T) {
                const float factor = which == 0u ? p.scale : 1.0;
                [[unroll]] for (uint j4 = 0u; j4 < TPL / 4u; ++j4) {
                    vec4 t4 = sT[trow + c0 / 4u + j4] * factor;
                    uint col = dd * 16u + c0 + j4 * 4u;
                    uint at = which == 0u
                        ? (b * p.kgB + hk * p.kgH + my_key * p.kgR + col) / 2u
                        : (b * p.vgB + hk * p.vgH + my_key * p.vgR + col) / 2u;
                    uint w0 = f32_to_elt(t4.x) | (f32_to_elt(t4.y) << 16);
                    uint w1 = f32_to_elt(t4.z) | (f32_to_elt(t4.w) << 16);
                    if (which == 0u) {
                        dk[at] = w0;
                        dk[at + 1u] = w1;
                    } else {
                        dv[at] = w0;
                        dv[at + 1u] = w1;
                    }
                }
            }
            subgroupMemoryBarrierShared();
            subgroupBarrier();
        }
    }
}
