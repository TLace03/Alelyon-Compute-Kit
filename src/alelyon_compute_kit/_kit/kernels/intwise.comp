#version 450
// intwise/v1 (2026-09-28): integer and bool pointwise operations over strided
// views of at most four dimensions, for the tensors the f32 pointwise family
// refuses by dtype and no float composition can carry exactly: int64 index
// arithmetic, int16 offsets, uint8 bit unpacking, bool masks. MEASURED
// 2026-09-27 (df5200c9): after convert/v1 and the adapter's composition, one
// toy stage-E step of the sub-bit student still sent about 1,200 such calls
// to the host (sub, add, mul, fill_, zero_, arange, compares, bitwise_and,
// bitwise_right_shift).
//
// STORAGE CODES (convert/v1's numbering; this family takes the integer ones):
//   3 i64  4 i32  5 i16  6 i8  7 u8  9 bool
//
// THE ANSWER IS torch's CPU KERNEL'S, BIT FOR BIT. torch computes a binary
// operation in the common dtype C of its operands (at::result_type) and casts
// the result to the output's dtype. Every value here is carried as a signed
// 64-bit integer (lo, hi) in 32-bit arithmetic, so shaderInt64 plays no part:
//   load      an operand is sign- or zero-extended from its own storage, then
//             WRAPPED to C (below); a scalar operand is wrapped to C as well
//   compute   add, sub and mul modulo 2^64. Truncation modulo 2^w commutes
//             with them, so wrapping the 64-bit result to C gives C's own
//             two's complement arithmetic, the wrap torch's C++ produces.
//   wrap      to C: i64 as is; i32, i16 and i8 sign-extended from their low
//             bits; u8 zero-extended; bool 1 if nonzero, else 0 (torch's bool
//             add is a logical or and its mul a logical and, which this is)
//   store     truncated to the output's width, bool as nonzero
// Shifts follow c10's BinaryOpsKernel exactly: with w the width of C and
// max = w - 1 for a signed C, w for u8, a right shift by b < 0 (read as C) or
// b >= max is a shift by max (the sign for a signed C, 0 for u8), and a left
// shift by b < 0 or b >= w is 0; otherwise a >> b (arithmetic for a signed C)
// and a << b, wrapped to C. abs and neg wrap (|MIN| is MIN). A comparison
// compares C values and yields 0 or 1.
//
// OPERATIONS (the op field; operands in brackets):
//   0 add [x, y|s] x + alpha*y   1 sub [x, y|s] x - alpha*y   2 mul [x, y|s]
//   3 and  4 or  5 xor  6 shl  7 shr                            [x, y|s]
//   8 eq  9 ne  10 lt  11 le  12 gt  13 ge                      [x, y|s]
//   14 neg [x]   15 abs [x]   16 fill [s]   17 arange: start s, step alpha,
//   element l (row-major over the shape) is s + l*alpha
//   18 div_trunc  19 div_floor  20 remainder  21 fmod           [x, s]
//   24 cumsum [x]: the running sum along the LAST dimension (schema 3; THE SCAN below)
//   25 tril [x]  26 triu [x]: x where column - row <= s (tril) or >= s (triu)
//   over the last two dimensions, else 0 (schema 4; TRIANGLES below)
//   27 rank_asc [x]  28 rank_desc [x]: each element's STABLE rank along the
//   LAST dimension, x of any storage code (schema 5; RANKS below)
// A missing tensor operand's binding is bound to some live buffer and never read.
//
// DIVISION (18-21) is c10's integer division by a SCALAR divisor, the only
// form the plan admits (a tensor divisor could hold a zero, and c10 raises
// ZeroDivisionError for that, which a shader cannot): the scalar wrapped to C
// is nonzero, and not -1 in an i32 or i64 C (MIN / -1 overflows C++'s
// division there). div_trunc is C++'s a / b; div_floor subtracts one where the
// signs differ and the remainder is nonzero (c10's div_floor_integer);
// remainder is Python's (the result takes the divisor's sign); fmod is C++'s
// a % b (the dividend's). The quotient and remainder come from an unsigned
// 64-bit restoring division of the magnitudes, with the signs applied after.
//
// THE SCAN (schema 3, 2026-09-28). 24 cumsum is torch's CPU cumsum along the
// request's LAST dimension, the row (the adapter moves torch's `dim` there).
// The CPU kernel (cpu_cum_base_kernel) casts x to the output's dtype, adds
// along the row in index order in acc_type (int64 for every integer type) and
// stores each running sum cast to the output, so element k of a row is
// C(x_0) + ... + C(x_k) wrapped to C, which is what this computes. Addition
// modulo 2^64 is associative and the wrap commutes with it, so the grouping
// of the additions cannot change a bit: one WORKGROUP a row (units = rows,
// the product of dimensions 0-2), each of its 64 invocations summing its own
// contiguous chunk of the row, then walking the chunk again from the sum of
// the chunks before it and writing every running sum. The output is written
// element by element, a 1- or 2-byte one always with atomics (F_ATOMIC), and
// may be x's own view (in place): an invocation reads each element of its
// chunk before it writes it, and writes only its chunk. C = bool is refused
// (torch's CPU kernel is not built for bool and raises); a bool x is 0 or 1.
// The row length is bounded by the plan alone (intwise_ops::SCAN_LIMIT): it
// bounds a dispatch's duration, not an address.
//
// TRIANGLES (schema 4, 2026-09-28). 25 tril and 26 triu are torch's tril and
// triu over the request's last two dimensions (row i, column j; the leading
// ones are the batch): element (.., i, j) is x's where j - i <= s (tril) or
// j - i >= s (triu), and 0 elsewhere. s is the scalar word read as a signed
// 64-bit diagonal, NOT wrapped to C: torch's diagonal is an int64 whatever the
// dtype. No arithmetic touches x, so an element is moved, not computed: the
// adapter sends a float, complex or bool tensor as the integer code of its
// width (x = out = C), and wrap(C, extend(C, bits)) is the bits themselves (a
// NaN's payload, a -0.0) while 0 is every dtype's zero (+0.0, false).
//
// RANKS (schema 5, 2026-09-28). 27 rank_asc and 28 rank_desc give each element
// of a row (the request's LAST dimension) its position in torch's STABLE sort
// of that row, wrapped to C: the number of elements that sort before it (below
// it for rank_asc, above it for rank_desc) plus the number EQUAL to it at a
// lower index. The adapter scatters values and indices by these ranks to make
// sort and topk. x may be any storage code, compared as torch's sort compares
// (MEASURED 2026-09-28, torch 2.14 CPU): integers and bool by value, and a
// float with -0.0 equal to +0.0 and every NaN equal to every other and above
// +infinity. Each element's key is an unsigned 64-bit value in that order: an
// integer's with its sign bit flipped; a float's bits made positive-ordered
// (a negative's complemented, a positive's sign bit set) after -0.0 becomes
// +0.0, and every NaN the one largest key. No float instruction is used. Each
// invocation walks its element's row once, so a rank costs its row's length;
// the plan bounds the row and the total work (intwise_ops::RANK_ROW_LIMIT,
// RANK_WORK_LIMIT), which bound a dispatch's duration, not an address.
//
// BINARY64 (schema 2, 2026-09-28). This file built with -DF64=1 is the module
// intwise_f64.spv. It computes torch's float64 pointwise arithmetic (C = f64)
// in the same 32-bit words, bit for bit as torch's x86 CPU kernels compute it,
// and no float instruction is used: IEEE 754 binary64 add, sub, mul and div,
// round to nearest even, subnormals kept (no flush), and torch's CPU NaN rule:
// a NaN operand comes out quieted; where both are NaN, mul and div return x's
// (x86 SSE's first operand) and add and sub return y's, because torch computes
// them as x + alpha*y and forms the product first (MEASURED 2026-09-28, torch
// 2.14 CPU: its vector body, scalar tail and strided loop alike); an invalid
// operation such as inf - inf, 0 * inf or 0/0 gives x86's default NaN,
// 0xFFF8000000000000. neg and abs only flip or clear the sign, a NaN's too,
// and do not quiet it. The arithmetic
// follows Berkeley SoftFloat's structure: a significand with its leading one
// at bit 62, ten rounding bits below the 53 kept, and every bit lost to a
// shift jammed into bit 0. Division is a 63-bit restoring division with the
// remainder as the sticky bit. An operand of any storage code is widened to
// f64 as torch casts it: exactly for f32, bf16, f16 (through f32) and the
// integers up to 2^53; int64 above that rounds to nearest even; a NaN gets
// the quiet bit (x86's cvtss2sd). The output is f64, or bool for a
// comparison (IEEE: a NaN is unordered, and -0 == +0).
//   0 add [x, y|s]: x + y (x - y when alpha is -1.0)   1 sub: x - y (or x + y)
//   2 mul   22 div   8-13 the comparisons              [x, y|s]
//   14 neg: the sign flipped (a NaN's too)   15 abs: the sign cleared
//   23 reciprocal [x]: 1 / x   16 fill [s]
// The scalar and alpha words carry an f64's bits. alpha is +1.0 or -1.0 only,
// because torch's CPU computes x + alpha*y two ways: one fused multiply-add
// in its vectorized loop, two roundings in its scalar one. For another alpha,
// the CPU's own answer depends on the path. The bitwise operations, the
// shifts, arange and the integer divisions are the integer module's; div and
// reciprocal are this module's.
//
// SUB-WORD OUTPUTS, as convert/v1 wrote them until 2026-10-01: a DENSE output
// of 1 or 2 bytes (row-major from a 32-bit word) is written a whole word per
// invocation, and any other one element per invocation with an atomicAnd that
// clears the element's bytes and an atomicOr that sets them (F_ATOMIC). An
// output may be an input's own view (in place): each invocation reads its
// elements before it writes them, and only them.
//
// POISON, DO NOT RETURN: a block that fails the diagnostic guards below (raw
// ABI misuse; the C entry validates everything first) writes the all-ones
// pattern where it would have written, so a drifted bound is loud.
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer X { uint xw[]; };
layout(std430, set = 0, binding = 1) readonly buffer Y { uint yw[]; };
layout(std430, set = 0, binding = 2) buffer Out { uint outw[]; };

// 27 words (108 bytes), below the 128 bytes every Vulkan device offers. These
// MIRROR src/intwise_ops.rs's IntwisePlan::push_words, word for word.
layout(push_constant) uniform Plan {
    uint codes;         // x 0-3, y 4-7, out 8-11, compute (C) 12-15, op 16-23
    uint flags;         // F_ATOMIC (bit 0), F_Y_SCALAR (bit 1)
    uint size0, size1, size2, size3;
    uint x_off, x_st0, x_st1, x_st2, x_st3;
    uint y_off, y_st0, y_st1, y_st2, y_st3;
    uint out_off, out_st0, out_st1, out_st2, out_st3;
    uint s_lo, s_hi;    // the scalar operand, fill's value, arange's start
    uint a_lo, a_hi;    // add and sub's alpha, arange's step
    uint units;         // invocations with work: output words (dense sub-word) or elements;
                        // the scan's rows, one workgroup each
    uint n;             // elements: size0 * size1 * size2 * size3
} p;

