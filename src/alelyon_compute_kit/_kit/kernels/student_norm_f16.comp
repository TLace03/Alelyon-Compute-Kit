#version 450
// student-norm-f16/v1 (2026-09-29): the sub-bit student's attention-block RMSNorms (with the residual add before
// the post-attention one) and its q/k norms with RoPE, forward and backward. The law is student.py's O12 Fusables'
// eager bodies, layer.py `rms_norm` and `_apply_rotary_pos_emb`: stated per operation below, and in f64 by
// src/student_norm_ops.rs `reference`, which tests/student_norm_abi.rs holds this kernel to.
//
// A 64-lane workgroup takes one row (op 0, op 2) or `rows_per_group` rows one after another (op 1, op 3, which sum
// the weight's gradient over them). Lane l owns the element pairs (2j, 2j + 1) for j = l, l + 64, ..., so every fp16
// word has one writer. Row sums: each lane in increasing element order, then a fixed tree over the 64 lanes: the
// same result run to run, and torch's order only up to its last bits.
//
//   op 0 NORM      h = x (+ delta); r = rsqrt(sum(h * h) / D + eps); n = T(h * r); y = w * n, where T is the cast
//                  to x's storage (identity for f32, fp16 rounding for fp16). y (f32) to out0 with Y32, fp16(y) to
//                  out1 with Y16, h (f32) to out2 with ADD.
//   op 1 NORM_BWD  x holds the saved h (f32). g = w * (dy (+ f32(dy16) with DY16)), dy read as 0 with DY_ABSENT
//                  (the fp16 copy's gradient alone: `_rms_norm16_f`, or an f32 output with no gradient);
//                  dx = (dh with DH) + (r * g - h * (r * r * r * (sum(h * g) / D))) to out0 (f32);
//                  the group's dw partial, sum of (dy (+ dy16)) * n, to out1 (groups x D f32).
//   op 2 QKNR      x fp16 (B, T, H, D): n16 = fp16(x * r); y = w * f32(n16); out = fp16(rope(y)), rope(y)[i] =
//                  y[i] * cos[t, i] + rot(y)[i] * sin[t, i] with rot(y) = cat(-y[D/2:], y[:D/2]) (each product
//                  rounded, then the sum: rotary-f32/v1's order), to out0 in (B, H, T, D), or (B, T, H, D) with
//                  SAME_LAYOUT.
//   op 3 QKNR_BWD  aux holds dout (fp16, the output's layout). gy = the rope backward of f32(dout) (rotary-f32/v1
//                  op 1's order); dn = f32(fp16(w * gy)); dx = fp16(r * dn - x * (r * r * r * (sum(x * dn) / D))) to
//                  out0 in x's layout; the group's dw partial, sum of gy * f32(n16), to out1.
//
// Bindings (a role an op does not use takes any buffer; the host plan checks sizes and aliasing):
//   0 x    1 aux: the delta (op 0 with ADD, f32 or fp16 by AUX16), dy16 (op 1 with DY16), dout (op 3)
//   2 w (D f32)   3 tab: cos then sin, 2 x (T x D) f32   4 out0   5 out1   6 dy (op 1, f32)
//   7 dh (op 1 with DH, f32) or h's output (op 0 with ADD, f32)
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer X { uint xw[]; };
layout(set = 0, binding = 1, std430) readonly buffer Aux { uint aux[]; };
layout(set = 0, binding = 2, std430) readonly buffer Wt { float wt[]; };
layout(set = 0, binding = 3, std430) readonly buffer Tab { float tab[]; };
layout(set = 0, binding = 4, std430) writeonly buffer Out0 { uint out0[]; };
layout(set = 0, binding = 5, std430) writeonly buffer Out1 { uint out1[]; };
layout(set = 0, binding = 6, std430) readonly buffer Dy { float dy[]; };
layout(set = 0, binding = 7, std430) buffer Io2 { float io2[]; };

// MIRRORS the host plan's push block, word for word.
layout(push_constant) uniform Push {
    uint op;
    uint flags;
    uint rows;            // ops 0/1: rows of D; ops 2/3: B * T * H
    uint D;
    uint eps_bits;
    uint T;               // ops 2/3: positions
    uint H;               // ops 2/3: heads
    uint rows_per_group;  // ops 1/3
    uint groups_x;
} p;

const uint X16 = 1u, AUX16 = 2u, ADD = 4u, Y32 = 8u, Y16 = 16u, DY16 = 32u, DH = 64u, SAME_LAYOUT = 128u,
           DY_ABSENT = 256u;
const uint MAX_PAIRS_A_LANE = 32u;   // D <= 4096 for ops 0/1
const uint MAX_QK_D = 256u;          // ops 2/3 stage a row in shared memory

shared float red[64];
shared float row_buf[MAX_QK_D];

uint f16_to_f32(uint h16) {
    uint sign = (h16 & 0x8000u) << 16u;
    uint e = (h16 >> 10u) & 0x1Fu;
    uint m = h16 & 0x3FFu;
    if (e == 0x1Fu) return sign | 0x7F800000u | (m << 13u);
    if (e == 0u) {
        if (m == 0u) return sign;
        uint t = uint(findMSB(m));
        return sign | ((t + 103u) << 23u) | ((m << (23u - t)) & 0x7FFFFFu);
    }
    return sign | ((e + 112u) << 23u) | (m << 13u);
}

uint f32_to_f16(uint wv) {
    uint sign = (wv >> 16u) & 0x8000u;
    uint e = (wv >> 23u) & 0xFFu;
    uint m = wv & 0x7FFFFFu;
    if (e == 0xFFu) return sign | (m != 0u ? 0x7E00u : 0x7C00u);
    int he = int(e) - 112;
    if (he >= 31) return sign | 0x7C00u;
    if (he <= 0) {
        if (he < -10) return sign;
        uint mf = m | 0x800000u;
        uint shift = uint(14 - he);
        uint q = mf >> shift;
        uint rem = mf & ((1u << shift) - 1u);
        uint half_ulp = 1u << (shift - 1u);
        if (rem > half_ulp || (rem == half_ulp && (q & 1u) != 0u)) q += 1u;
        return sign | q;
    }
    uint h16 = (uint(he) << 10u) | (m >> 13u);
    uint rem = m & 0x1FFFu;
    if (rem > 0x1000u || (rem == 0x1000u && (h16 & 1u) != 0u)) h16 += 1u;
    return sign | h16;
}

float round16(float v) { return uintBitsToFloat(f16_to_f32(f32_to_f16(floatBitsToUint(v)))); }
uint pack_f16x2(float a, float b) { return f32_to_f16(floatBitsToUint(a)) | (f32_to_f16(floatBitsToUint(b)) << 16u); }
vec2 unpack_f16x2(uint word) { return vec2(uintBitsToFloat(f16_to_f32(word & 0xFFFFu)), uintBitsToFloat(f16_to_f32(word >> 16u))); }

// the pair (i, i + 1), i even, of a buffer of f32 words or of fp16 pairs
vec2 x_pair(uint i) { return (p.flags & X16) != 0u ? unpack_f16x2(xw[i >> 1u]) : vec2(uintBitsToFloat(xw[i]), uintBitsToFloat(xw[i + 1u])); }
vec2 aux_pair(uint i, bool is16) { return is16 ? unpack_f16x2(aux[i >> 1u]) : vec2(uintBitsToFloat(aux[i]), uintBitsToFloat(aux[i + 1u])); }

float sum64(float v) {
    uint lane = gl_LocalInvocationID.x;
    red[lane] = v;
    barrier();
    [[unroll]] for (uint s = 32u; s > 0u; s >>= 1u) {
        if (lane < s) red[lane] = red[lane] + red[lane + s];
        barrier();
    }
    float total = red[0];
    barrier();
    return total;
}

float rsqrt_of(float sum_sq, float eps) {
    precise float v = sum_sq / float(p.D);
    precise float ve = v + eps;
    return inversesqrt(ve);
}

// the row of (B, H, T, D) (or (B, T, H, D) with SAME_LAYOUT) that holds input row `row` = (b, t, h) of (B, T, H, D)
uint out_row(uint row) {
    if ((p.flags & SAME_LAYOUT) != 0u) return row;
    uint h = row % p.H;
    uint bt = row / p.H;
    uint t = bt % p.T;
    uint b = bt / p.T;
    return (b * p.H + h) * p.T + t;
}

void norm_forward(uint row, uint lane, float eps) {
    uint D = p.D, base = row * D;
    bool add = (p.flags & ADD) != 0u;
    vec2 hv[MAX_PAIRS_A_LANE];
    float ss = 0.0;
    uint k = 0u;
    for (uint j = lane; j < D / 2u; j += 64u, ++k) {
        uint i = 2u * j;
        vec2 h = x_pair(base + i);
        if (add) {
            vec2 d = aux_pair(base + i, (p.flags & AUX16) != 0u);
            precise float h0 = h.x + d.x;
            precise float h1 = h.y + d.y;
            h = vec2(h0, h1);
            io2[base + i] = h.x;
            io2[base + i + 1u] = h.y;
        }
        hv[k] = h;
        precise float s0 = h.x * h.x;
        precise float s1 = h.y * h.y;
        ss = ss + s0;
        ss = ss + s1;
    }
    float r = rsqrt_of(sum64(ss), eps);
    bool narrow = (p.flags & X16) != 0u;
    k = 0u;
    for (uint j = lane; j < D / 2u; j += 64u, ++k) {
        uint i = 2u * j;
        precise float n0 = hv[k].x * r;
        precise float n1 = hv[k].y * r;
        if (narrow) {
            n0 = round16(n0);
            n1 = round16(n1);
        }
        precise float y0 = wt[i] * n0;
        precise float y1 = wt[i + 1u] * n1;
        if ((p.flags & Y32) != 0u) {
            out0[base + i] = floatBitsToUint(y0);
            out0[base + i + 1u] = floatBitsToUint(y1);
        }
        if ((p.flags & Y16) != 0u) out1[(base + i) >> 1u] = pack_f16x2(y0, y1);
    }
}

// op 1: rows [r0, r0 + n) of the saved h (f32), their dx, and the group's dw partial
void norm_backward(uint r0, uint n, uint group, uint lane, float eps) {
    uint D = p.D;
    bool dy16 = (p.flags & DY16) != 0u;
    bool dy32 = (p.flags & DY_ABSENT) == 0u;
    vec2 dw[MAX_PAIRS_A_LANE];
    for (uint k = 0u; k < MAX_PAIRS_A_LANE; ++k) dw[k] = vec2(0.0);
    for (uint row = r0; row < r0 + n; ++row) {
        uint base = row * D;
        float ss = 0.0;
        float shg = 0.0;
        for (uint j = lane; j < D / 2u; j += 64u) {
            uint i = 2u * j;
            vec2 h = vec2(uintBitsToFloat(xw[base + i]), uintBitsToFloat(xw[base + i + 1u]));
            vec2 d = dy32 ? vec2(dy[base + i], dy[base + i + 1u]) : vec2(0.0);
            if (dy16) {
                vec2 e = unpack_f16x2(aux[(base + i) >> 1u]);
                precise float d0 = d.x + e.x;
                precise float d1 = d.y + e.y;
                d = dy32 ? vec2(d0, d1) : e;   // the fp16 gradient alone is taken as it is (a -0 stays -0)
            }
            precise float g0 = wt[i] * d.x;
            precise float g1 = wt[i + 1u] * d.y;
            precise float s0 = h.x * h.x;
            precise float s1 = h.y * h.y;
            ss = ss + s0;
            ss = ss + s1;
            precise float t0 = h.x * g0;
            precise float t1 = h.y * g1;
            shg = shg + t0;
            shg = shg + t1;
        }
        float sum_sq = sum64(ss);
        float sum_hg = sum64(shg);
        float r = rsqrt_of(sum_sq, eps);
        precise float r3 = r * r * r;
        precise float c = r3 * (sum_hg / float(D));
        uint k = 0u;
        for (uint j = lane; j < D / 2u; j += 64u, ++k) {
            uint i = 2u * j;
            vec2 h = vec2(uintBitsToFloat(xw[base + i]), uintBitsToFloat(xw[base + i + 1u]));
            vec2 d = dy32 ? vec2(dy[base + i], dy[base + i + 1u]) : vec2(0.0);
            if (dy16) {
                vec2 e = unpack_f16x2(aux[(base + i) >> 1u]);
                precise float d0 = d.x + e.x;
                precise float d1 = d.y + e.y;
                d = dy32 ? vec2(d0, d1) : e;   // the fp16 gradient alone is taken as it is (a -0 stays -0)
            }
            precise float g0 = wt[i] * d.x;
            precise float g1 = wt[i + 1u] * d.y;
            precise float a0 = r * g0;
            precise float a1 = r * g1;
            precise float b0 = h.x * c;
            precise float b1 = h.y * c;
            precise float dx0 = a0 - b0;
            precise float dx1 = a1 - b1;
            if ((p.flags & DH) != 0u) {
                precise float e0 = io2[base + i] + dx0;
                precise float e1 = io2[base + i + 1u] + dx1;
                dx0 = e0;
                dx1 = e1;
            }
            out0[base + i] = floatBitsToUint(dx0);
            out0[base + i + 1u] = floatBitsToUint(dx1);
            precise float n0 = h.x * r;
            precise float n1 = h.y * r;
            precise float w0 = d.x * n0;
            precise float w1 = d.y * n1;
            dw[k] = vec2(dw[k].x + w0, dw[k].y + w1);
        }
    }
    uint k = 0u;
    for (uint j = lane; j < D / 2u; j += 64u, ++k) {
        uint i = 2u * j;
        out1[group * D + i] = floatBitsToUint(dw[k].x);
        out1[group * D + i + 1u] = floatBitsToUint(dw[k].y);
    }
}

// op 2: one (b, t, h) row of q or k, normed then rotated, written at fp16 in the output's layout
void qknr_forward(uint row, uint lane, float eps) {
    uint D = p.D;
    uint half_d = p.D / 2u;
    uint base = row * D;
    uint t = (row / p.H) % p.T;
    float ss = 0.0;
    for (uint j = lane; j < D / 2u; j += 64u) {
        vec2 x = unpack_f16x2(xw[(base >> 1u) + j]);
        precise float s0 = x.x * x.x;
        precise float s1 = x.y * x.y;
        ss = ss + s0;
        ss = ss + s1;
    }
    float r = rsqrt_of(sum64(ss), eps);
    for (uint j = lane; j < D / 2u; j += 64u) {
        uint i = 2u * j;
        vec2 x = unpack_f16x2(xw[(base >> 1u) + j]);
        precise float n0 = x.x * r;
        precise float n1 = x.y * r;
        precise float y0 = wt[i] * round16(n0);
        precise float y1 = wt[i + 1u] * round16(n1);
        row_buf[i] = y0;
        row_buf[i + 1u] = y1;
    }
    barrier();
    uint tb = t * D;
    uint sin_at = p.T * D + tb;
    uint ob = out_row(row) * D;
    for (uint j = lane; j < D / 2u; j += 64u) {
        uint i = 2u * j;
        float o0 = 0.0;
        float o1 = 0.0;
        for (uint e = 0u; e < 2u; ++e) {
            uint c = i + e;
            precise float m0 = row_buf[c] * tab[tb + c];
            float rot = c < half_d ? -row_buf[c + half_d] : row_buf[c - half_d];
            precise float m1 = rot * tab[sin_at + c];
            precise float sum = m0 + m1;
            if (e == 0u) o0 = sum; else o1 = sum;
        }
        out0[(ob + i) >> 1u] = pack_f16x2(o0, o1);
    }
    barrier();
}

// op 3: rows [r0, r0 + n) of (b, t, h), the input's gradient at fp16 and the group's dw partial
void qknr_backward(uint r0, uint n, uint group, uint lane, float eps) {
    uint D = p.D;
    uint half_d = p.D / 2u;
    vec2 dw[MAX_PAIRS_A_LANE];
    for (uint k = 0u; k < MAX_PAIRS_A_LANE; ++k) dw[k] = vec2(0.0);
    for (uint row = r0; row < r0 + n; ++row) {
        uint base = row * D;
        uint t = (row / p.H) % p.T;
        uint tb = t * D;
        uint sin_at = p.T * D + tb;
        uint ob = out_row(row) * D;
        for (uint j = lane; j < D / 2u; j += 64u) {
            vec2 g = unpack_f16x2(aux[(ob >> 1u) + j]);
            row_buf[2u * j] = g.x;
            row_buf[2u * j + 1u] = g.y;
        }
        barrier();
        float ss = 0.0;
        for (uint j = lane; j < D / 2u; j += 64u) {
            vec2 x = unpack_f16x2(xw[(base >> 1u) + j]);
            precise float s0 = x.x * x.x;
            precise float s1 = x.y * x.y;
            ss = ss + s0;
            ss = ss + s1;
        }
        float r = rsqrt_of(sum64(ss), eps);
        // the rope backward (rotary-f32/v1 op 1's order), n16's gradient kept at fp16, and sum(x * dn)
        float sxd = 0.0;
        uint k = 0u;
        for (uint j = lane; j < D / 2u; j += 64u, ++k) {
            uint i = 2u * j;
            vec2 x = unpack_f16x2(xw[(base >> 1u) + j]);
            for (uint e = 0u; e < 2u; ++e) {
                uint c = i + e;
                precise float m0 = row_buf[c] * tab[tb + c];
                float gy;
                if (c < half_d) {
                    precise float m1 = row_buf[c + half_d] * tab[sin_at + c + half_d];
                    precise float s = m0 + m1;
                    gy = s;
                } else {
                    precise float m1 = row_buf[c - half_d] * tab[sin_at + c - half_d];
                    precise float s = m0 - m1;
                    gy = s;
                }
                float xe = e == 0u ? x.x : x.y;
                precise float nn = xe * r;
                float n16 = round16(nn);
                precise float dnf = wt[c] * gy;
                float dn = round16(dnf);
                precise float t0 = xe * dn;
                sxd = sxd + t0;
                precise float wv = gy * n16;
                if (e == 0u) dw[k].x = dw[k].x + wv; else dw[k].y = dw[k].y + wv;
            }
        }
        float sum_xd = sum64(sxd);
        precise float r3 = r * r * r;
        precise float cc = r3 * (sum_xd / float(D));
        for (uint j = lane; j < D / 2u; j += 64u) {
            uint i = 2u * j;
            vec2 x = unpack_f16x2(xw[(base >> 1u) + j]);
            float dn0 = 0.0;
            float dn1 = 0.0;
            for (uint e = 0u; e < 2u; ++e) {
                uint c = i + e;
                precise float m0 = row_buf[c] * tab[tb + c];
                float gy;
                if (c < half_d) {
                    precise float m1 = row_buf[c + half_d] * tab[sin_at + c + half_d];
                    precise float s = m0 + m1;
                    gy = s;
                } else {
                    precise float m1 = row_buf[c - half_d] * tab[sin_at + c - half_d];
                    precise float s = m0 - m1;
                    gy = s;
                }
                precise float dnf = wt[c] * gy;
                if (e == 0u) dn0 = round16(dnf); else dn1 = round16(dnf);
            }
            precise float a0 = r * dn0;
            precise float a1 = r * dn1;
            precise float b0 = x.x * cc;
            precise float b1 = x.y * cc;
            precise float dx0 = a0 - b0;
            precise float dx1 = a1 - b1;
            out0[(base + i) >> 1u] = pack_f16x2(dx0, dx1);
        }
        barrier();
    }
    uint k = 0u;
    for (uint j = lane; j < D / 2u; j += 64u, ++k) {
        uint i = 2u * j;
        out1[group * D + i] = floatBitsToUint(dw[k].x);
        out1[group * D + i + 1u] = floatBitsToUint(dw[k].y);
    }
}

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint wg = gl_WorkGroupID.x + gl_WorkGroupID.y * p.groups_x;
    float eps = uintBitsToFloat(p.eps_bits);
    if (p.op == 0u || p.op == 2u) {
        if (wg >= p.rows) return;
        if (p.op == 0u) norm_forward(wg, lane, eps);
        else qknr_forward(wg, lane, eps);
        return;
    }
    uint r0 = wg * p.rows_per_group;
    if (r0 >= p.rows) return;
    uint n = min(p.rows_per_group, p.rows - r0);
    if (p.op == 1u) norm_backward(r0, n, wg, lane, eps);
    else qknr_backward(r0, n, wg, lane, eps);
}
