#version 450
// Fused attention, forward (attention-v2, 2026-09-27):
//   O = softmax(scale * Q K^T + causal mask) V,   LSE = rowwise log-sum-exp
// per (batch, query head), without writing the [T, T] scores: FlashAttention-2's
// forward recurrence on KHR cooperative matrices, as attention-bf16/v1, for
// head dimension D = 64 or 128 (a define; one module per D and subgroup width).
//
// WHAT CHANGED FROM v1, and why:
//   * The running output O stays in cooperative-matrix ACCUMULATORS for the
//     whole key loop. v1 kept it in plain registers because a cooperative
//     matrix cannot be scaled per row, which sent every block's P V product
//     through shared memory as f32 and back. Here the per-row rescale is a
//     component-wise product with a matrix LOADED from a shared tile whose row
//     r holds alpha_r in every column: two matrices of the same type map their
//     components to (row, column) the same way, so the product scales row r by
//     alpha_r whatever the vendor's layout is.
//   * Shared rows carry 16 bytes of padding, so the column-major K^T fragment
//     loads (16 rows at the same column) and the row-major P and V loads do
//     not all land on one bank, and operands move as 16-byte words when their
//     strides allow (a uniform test on the push block; otherwise 4-byte words).
//   * Key blocks are BC = 32 wide and the shared footprint stays within the
//     32 KiB the Vulkan spec lets a driver report as maxComputeSharedMemorySize
//     (the six v1 modules declare 40-41 KiB): 31,744 bytes at D = 128,
//     23,552 at D = 64.
//   * The softmax runs in the base-2 domain (the scale carries log2(e)); the
//     LSE written is the natural log-sum-exp, m ln 2 + ln l.
//   * Causal query blocks are dispatched longest first.
//
// ONE WORKGROUP = one (batch, query head, block of BR = 64 query rows), as
// NSG = 4 subgroups; subgroup s owns query rows [16s, 16s + 16) of the block.
//
// GROUPED KV HEADS: query head h reads kv head h / (H / HKV), in place.
//
// NUMERICS: S and O accumulate in f32; the block's unnormalised probabilities
// are rounded to bf16 for the P V product (v1's contract). Held to an fp64
// reference in tests/attention_v2.rs.
//
// ELEMENT TYPE (2026-09-29): bf16 by default; -DELT_F16=1 builds the same
// kernel over binary16 (fp16) q, k, v and outputs, for the fp16 autocast the
// stage-E step is registered with. Only the cooperative-matrix element type
// (ELT), the rounding of a float to it (f32_to_elt) and, in the backward, the
// decoding of a stored pair (elt_lo / elt_hi) differ; the fp16 ones are exact
// integer routines, so no CONVERSION depends on a device's float controls
// (with -DF16_HW=1 the device's own conversions under declared round-to-
// nearest-even and denormal preservation, the same rule; see below). The fp16
// modules' f32 arithmetic is pinned by NoContraction on every float result,
// added after compiling (kernels/no_contraction.py, 2026-09-30): without it
// the driver contracted the two builds' identical arithmetic differently. The
// bf16 modules' preprocessed source is what it was before this switch.
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#ifdef ELT_F16
#define ELT float16_t
#else
#extension GL_EXT_bfloat16 : require
#define ELT bfloat16_t
#endif
#extension GL_EXT_control_flow_attributes : require
#if defined(ELT_F16) && defined(F16_HW)
// HARDWARE BINARY16 CONVERSION (2026-09-29). -DF16_HW=1 declares round to
// nearest even and denormal preservation for 16-bit floats. A device grants
// both only when it reports shaderRoundingModeRTEFloat16 and
// shaderDenormPreserveFloat16, and the host builds these modules only then
// (ffi::attention_f16_hardware). A float16_t conversion is then IEEE's: round
// to nearest even, subnormals kept, an overflow to infinity. That is the
// integer routine's rule in one instruction. Infinities and NaNs keep the
// integer routines' bits, so the two modules agree on every input
// (tests/attention_v2.rs holds them to it, bit for bit).
#extension GL_EXT_spirv_intrinsics : require
spirv_execution_mode(capabilities = [4467], 4462, 16);   // RoundingModeRTE, 16-bit floats
spirv_execution_mode(capabilities = [4464], 4459, 16);   // DenormPreserve, 16-bit floats
#endif

#ifndef SGW
#define SGW 64
#endif
#ifndef D
#define D 128
#endif
#define BC 32
#define BR 64
#define NSG 4
#define WG (NSG * SGW)
#define LPR (SGW / 16)       // lanes per query row in the softmax phase
#define CPL (BC / LPR)       // score columns per lane
#define DW (D / 2)           // uints (bf16 pairs) per row of D
#define VPR (D / 8)          // 16-byte words per row of D
#define KSV (VPR + 1)        // shared row stride of Q, K and V, in 16-byte words
#define SSV (BC / 4 + 1)     // shared row stride of S, in vec4
#define PSV (BC / 8 + 1)     // shared row stride of P, in 16-byte words
#define FV (4 / LPR)         // vec4 each lane writes of a row's 16-column fill

layout(local_size_x = WG, local_size_y = 1, local_size_z = 1) in;

// q, k, v and o are bf16, addressed as uints holding two elements or as
// 16-byte words holding eight; every stride is in ELEMENTS and even.
layout(std430, set = 0, binding = 0) readonly buffer Qb { uint q[]; };
layout(std430, set = 0, binding = 0) readonly buffer Qb4 { uvec4 q4[]; };
layout(std430, set = 0, binding = 1) readonly buffer Kb { uint k[]; };
layout(std430, set = 0, binding = 1) readonly buffer Kb4 { uvec4 k4[]; };
layout(std430, set = 0, binding = 2) readonly buffer Vb { uint v[]; };
layout(std430, set = 0, binding = 2) readonly buffer Vb4 { uvec4 v4[]; };
layout(std430, set = 0, binding = 3) writeonly buffer Ob { uint o[]; };
layout(std430, set = 0, binding = 4) writeonly buffer Lb { float lse[]; };

layout(push_constant) uniform P {
    uint T, H, HKV, causal;
    uint qB, qH, qR;
    uint kB, kH, kR;
    uint vB, vH, vR;
    uint oB, oH, oR;
    float scale;
} p;

#define NEG_INF uintBitsToFloat(0xFF800000u)
#define LOG2E 1.4426950408889634
#define LN2 0.6931471805599453

shared uvec4 sKV[2 * BC * KSV];   // the Q block, then each key block's K rows and V rows
shared vec4 sS[BR * SSV];         // S; then a row's fill (alpha or 1/l); then an output tile
shared uvec4 sP[BR * PSV];        // P, bf16

#ifdef ELT_F16
// binary32 -> binary16, round to nearest even, subnormals kept, an overflow to
// infinity, a NaN quieted with its payload's top bits: integer instructions
// only, so its bits do not depend on the device's float controls
#ifdef F16_HW
uint f32_to_f16(float x) {
    const uint bits = floatBitsToUint(x);
    const uint a = bits & 0x7FFFFFFFu;
    if (a > 0x7F800000u) {   // a NaN: the integer routine's bits (quieted, the payload's top bits)
        return ((bits >> 16) & 0x8000u) | 0x7E00u | ((a >> 13) & 0x03FFu);
    }
    return uint(float16BitsToUint16(float16_t(x)));
}
#else
uint f32_to_f16(float x) {
    const uint bits = floatBitsToUint(x);
    const uint sign = (bits >> 16) & 0x8000u;
    const uint a = bits & 0x7FFFFFFFu;
    if (a >= 0x7F800000u) {
        return sign | 0x7C00u | (a > 0x7F800000u ? (0x0200u | ((a >> 13) & 0x03FFu)) : 0u);
    }
    if (a >= 0x477FF000u) return sign | 0x7C00u;       // 65520 and above round to infinity
    if (a >= 0x38800000u) {                              // a normal binary16
        const uint r = a - 0x38000000u;
        uint h = r >> 13;
        const uint rest = r & 0x1FFFu;
        if (rest > 0x1000u || (rest == 0x1000u && (h & 1u) != 0u)) h += 1u;
        return sign | h;
    }
    if (a < 0x33000000u) return sign;                    // below half the smallest subnormal
    const uint e = a >> 23;                              // 102 .. 112
    const uint m = (a & 0x7FFFFFu) | 0x800000u;
    const uint shift = 126u - e;                         // 14 .. 24
    uint h = m >> shift;
    const uint rest = m & ((1u << shift) - 1u);
    const uint half_ulp = 1u << (shift - 1u);
    if (rest > half_ulp || (rest == half_ulp && (h & 1u) != 0u)) h += 1u;
    return sign | h;                                     // 0x0400 when it rounds up to the smallest normal
}
#endif
#define f32_to_elt f32_to_f16
#else
uint f32_to_bf16(float x) {
    uint bits = floatBitsToUint(x);
    if ((bits & 0x7F800000u) == 0x7F800000u && (bits & 0x007FFFFFu) != 0u) {
        return (bits >> 16) | 0x0040u;   // quiet NaN
    }
    uint lsb = (bits >> 16) & 1u;
    return (bits + 0x7FFFu + lsb) >> 16;
}
#define f32_to_elt f32_to_bf16
#endif

void main() {
    const uint nqb = (p.T + BR - 1u) / BR;
    const uint qblock = p.causal != 0u ? nqb - 1u - gl_WorkGroupID.x : gl_WorkGroupID.x;
    const uint h = gl_WorkGroupID.y;
    const uint b = gl_WorkGroupID.z;
    const uint hk = h / (p.H / p.HKV);
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint tid = gl_LocalInvocationID.x;
    const uint row = lane / LPR;          // this lane's row within the subgroup's 16
    const uint part = lane % LPR;         // which slice of the row's columns
    const uint qrow0 = qblock * BR;
    const uint my_q = qrow0 + sg * 16u + row;
    const uint srow = (sg * 16u + row) * SSV;
    const float sl2 = p.scale * LOG2E;

    const uint qbase = b * p.qB + h * p.qH;
    const uint kbase = b * p.kB + hk * p.kH;
    const uint vbase = b * p.vB + hk * p.vH;
    const bool vecq = ((p.qB | p.qH | p.qR) & 7u) == 0u;
    const bool veckv = ((p.kB | p.kH | p.kR | p.vB | p.vH | p.vR) & 7u) == 0u;

    // the Q block, rows past T as zero
    if (vecq) {
        for (uint i = tid; i < BR * VPR; i += WG) {
            uint r = i / VPR, c = i % VPR, qr = qrow0 + r;
            sKV[r * KSV + c] = qr < p.T ? q4[(qbase + qr * p.qR) / 8u + c] : uvec4(0u);
        }
    } else {
        for (uint i = tid; i < BR * DW; i += WG) {
            uint r = i / DW, c = i % DW, qr = qrow0 + r;
            sKV[r * KSV + c / 4u][c % 4u] = qr < p.T ? q[(qbase + qr * p.qR) / 2u + c] : 0u;
        }
    }
    barrier();
    coopmat<ELT, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> qa[D / 16];
    [[unroll]] for (uint kk = 0u; kk < D / 16u; ++kk) {
        coopMatLoad(qa[kk], sKV, (sg * 16u) * KSV + kk * 2u, KSV, gl_CooperativeMatrixLayoutRowMajor);
    }
    coopmat<float32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> oacc[D / 16];
    [[unroll]] for (uint dd = 0u; dd < D / 16u; ++dd) {
        oacc[dd] = coopmat<float32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    }

    float m = NEG_INF;   // running max, base-2 domain
    float l = 0.0;       // running sum
    const uint nkb = (p.T + BC - 1u) / BC;
    const uint last = p.causal != 0u ? min(nkb, (qrow0 + BR + BC - 1u) / BC) : nkb;
    for (uint kb = 0u; kb < last; ++kb) {
        const uint krow0 = kb * BC;
        barrier();   // the Q fragments are loaded, and every subgroup is done with the last K and V
        if (veckv) {
            for (uint i = tid; i < BC * VPR; i += WG) {
                uint r = i / VPR, c = i % VPR, kr = krow0 + r;
                bool in_range = kr < p.T;
                sKV[r * KSV + c] = in_range ? k4[(kbase + kr * p.kR) / 8u + c] : uvec4(0u);
                sKV[(BC + r) * KSV + c] = in_range ? v4[(vbase + kr * p.vR) / 8u + c] : uvec4(0u);
            }
        } else {
            for (uint i = tid; i < BC * DW; i += WG) {
                uint r = i / DW, c = i % DW, kr = krow0 + r;
                bool in_range = kr < p.T;
                sKV[r * KSV + c / 4u][c % 4u] = in_range ? k[(kbase + kr * p.kR) / 2u + c] : 0u;
                sKV[(BC + r) * KSV + c / 4u][c % 4u] = in_range ? v[(vbase + kr * p.vR) / 2u + c] : 0u;
            }
        }
        barrier();

        // S = Q K^T for this subgroup's 16 rows, into its rows of sS
        [[unroll]] for (uint jb = 0u; jb < BC / 16u; ++jb) {
            coopmat<float32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> s =
                coopmat<float32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
            [[unroll]] for (uint kk = 0u; kk < D / 16u; ++kk) {
                coopmat<ELT, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> kt;
                coopMatLoad(kt, sKV, (jb * 16u) * KSV + kk * 2u, KSV, gl_CooperativeMatrixLayoutColumnMajor);
                s = coopMatMulAdd(qa[kk], kt, s);
            }
            coopMatStore(s, sS, (sg * 16u) * SSV + jb * 4u, SSV, gl_CooperativeMatrixLayoutRowMajor);
        }
        subgroupMemoryBarrierShared();
        subgroupBarrier();

        // online softmax over this lane's CPL columns of its row
        float x[CPL];
        float bmax = NEG_INF;
        [[unroll]] for (uint c4 = 0u; c4 < CPL / 4u; ++c4) {
            vec4 s4 = sS[srow + part * (CPL / 4u) + c4];
            [[unroll]] for (uint e = 0u; e < 4u; ++e) {
                uint key = krow0 + part * CPL + c4 * 4u + e;
                bool masked = key >= p.T || (p.causal != 0u && key > my_q);
                float val = masked ? NEG_INF : s4[e] * sl2;
                x[c4 * 4u + e] = val;
                bmax = max(bmax, val);
            }
        }
        [[unroll]] for (uint off = 1u; off < LPR; off <<= 1u) {
            bmax = max(bmax, subgroupShuffleXor(bmax, off));
        }
        const float m_new = max(m, bmax);
        // a row with every key so far masked keeps m = -inf and accumulates
        // nothing; its first admissible block zeroes the (empty) output by alpha = 0
        const bool none = m_new == NEG_INF;
        const float alpha = none ? 1.0 : (m == NEG_INF ? 0.0 : exp2(m - m_new));
        float bsum = 0.0;
        [[unroll]] for (uint c8 = 0u; c8 < CPL / 8u; ++c8) {
            uvec4 w;
            [[unroll]] for (uint e = 0u; e < 4u; ++e) {
                float x0 = x[c8 * 8u + 2u * e];
                float x1 = x[c8 * 8u + 2u * e + 1u];
                float p0 = (none || x0 == NEG_INF) ? 0.0 : exp2(x0 - m_new);
                float p1 = (none || x1 == NEG_INF) ? 0.0 : exp2(x1 - m_new);
                bsum += p0 + p1;
                w[e] = f32_to_elt(p0) | (f32_to_elt(p1) << 16);
            }
            sP[(sg * 16u + row) * PSV + part * (CPL / 8u) + c8] = w;
        }
        [[unroll]] for (uint off = 1u; off < LPR; off <<= 1u) {
            bsum += subgroupShuffleXor(bsum, off);
        }
        l = l * alpha + bsum;
        m = m_new;

        // alpha, row by row, over the first 16 columns of this subgroup's sS
        // rows (every lane has read its S above), then O *= alpha
        subgroupMemoryBarrierShared();
        subgroupBarrier();
        [[unroll]] for (uint f = 0u; f < FV; ++f) {
            sS[srow + part * FV + f] = vec4(alpha);
        }
        subgroupMemoryBarrierShared();
        subgroupBarrier();
        coopmat<float32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> amat;
        coopMatLoad(amat, sS, (sg * 16u) * SSV, SSV, gl_CooperativeMatrixLayoutRowMajor);
        [[unroll]] for (uint dd = 0u; dd < D / 16u; ++dd) {
            oacc[dd] = oacc[dd] * amat;
        }

        // O += P V
        coopmat<ELT, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> pa[BC / 16];
        [[unroll]] for (uint jj = 0u; jj < BC / 16u; ++jj) {
            coopMatLoad(pa[jj], sP, (sg * 16u) * PSV + jj * 2u, PSV, gl_CooperativeMatrixLayoutRowMajor);
        }
        [[unroll]] for (uint dd = 0u; dd < D / 16u; ++dd) {
            [[unroll]] for (uint jj = 0u; jj < BC / 16u; ++jj) {
                coopmat<ELT, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> vb;
                coopMatLoad(vb, sKV, (BC + jj * 16u) * KSV + dd * 2u, KSV, gl_CooperativeMatrixLayoutRowMajor);
                oacc[dd] = coopMatMulAdd(pa[jj], vb, oacc[dd]);
            }
        }
    }

    // O / l: the fill of 1/l in columns 0..15, each output tile through columns
    // 16..31 of this subgroup's sS rows, rounded to bf16 for the rows below T
    const float inv = 1.0 / l;
    subgroupMemoryBarrierShared();
    subgroupBarrier();
    [[unroll]] for (uint f = 0u; f < FV; ++f) {
        sS[srow + part * FV + f] = vec4(inv);
    }
    subgroupMemoryBarrierShared();
    subgroupBarrier();
    coopmat<float32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> imat;
    coopMatLoad(imat, sS, (sg * 16u) * SSV, SSV, gl_CooperativeMatrixLayoutRowMajor);
    const uint obase = b * p.oB + h * p.oH + my_q * p.oR;
    [[unroll]] for (uint dd = 0u; dd < D / 16u; ++dd) {
        coopmat<float32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> t = oacc[dd] * imat;
        coopMatStore(t, sS, (sg * 16u) * SSV + 4u, SSV, gl_CooperativeMatrixLayoutRowMajor);
        subgroupMemoryBarrierShared();
        subgroupBarrier();
        if (my_q < p.T) {
            [[unroll]] for (uint f = 0u; f < FV; ++f) {
                vec4 v4o = sS[srow + 4u + part * FV + f];
                uint at = (obase + dd * 16u + (part * FV + f) * 4u) / 2u;
                o[at] = f32_to_elt(v4o.x) | (f32_to_elt(v4o.y) << 16);
                o[at + 1u] = f32_to_elt(v4o.z) | (f32_to_elt(v4o.w) << 16);
            }
        }
        subgroupMemoryBarrierShared();
        subgroupBarrier();   // every lane has read the tile before the next one lands
    }
    if (my_q < p.T && part == 0u) {
        lse[(b * p.H + h) * p.T + my_q] = m * LN2 + log(l);
    }
}
