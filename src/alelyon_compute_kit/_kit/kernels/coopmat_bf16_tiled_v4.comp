void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint sg = gl_SubgroupID;
    const uint sgRow = sg / SG_COLS;
    const uint sgCol = sg % SG_COLS;
#if RAST
    // (RAST, the WORKGROUP ORDER note) RAST tile rows down one tile column, then
    // the next column; the last band holds the rows that remain. A bijection of
    // the grid's tiles: the workgroups of a band are its rows x every column.
    const uint linear = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    const uint bandSize = uint(RAST) * gl_NumWorkGroups.x;
    const uint firstRow = (linear / bandSize) * uint(RAST);
    const uint rowsInBand = min(gl_NumWorkGroups.y - firstRow, uint(RAST));
    const uint within = linear % bandSize;
    const uint tileRow = (firstRow + within % rowsInBand) * BM;
    const uint tileCol = (within / rowsInBand) * BN;
#else
    const uint tileRow = gl_WorkGroupID.y * BM;
    const uint tileCol = gl_WorkGroupID.x * BN;
#endif
    const uint z = gl_WorkGroupID.z;
    uint kBegin = 0u;
    uint kEnd = p.K;
#if NF4_B
    // (NF4_B) z is a routed expert: its first row of A and C, its row count, and
    // its weight's first value in the source
    const uint rowStart = nf4_groups[3u * z];
    const uint mRows = nf4_groups[3u * z + 1u];
    const uint wBase = nf4_groups[3u * z + 2u];
    const uint cBase = rowStart * p.N;
#elif GROUPED
    // (GROUPED) z is a routed expert, as for NF4_B: its first row of A and C, its
    // row count, and its weight's first element in B
    const uint rowStart = moe_groups[3u * z];
    const uint mRows = moe_groups[3u * z + 1u];
    const uint wBase = moe_groups[3u * z + 2u];
    const uint cBase = rowStart * p.N;
#else
    const uint cBase = z * p.zc;
#endif
    if (p.zmode == 1u) {
        kBegin = z * p.kz;
        kEnd = min(p.K, kBegin + p.kz);
    } else {
        aBase = z * p.za;
        bBase = z * p.zb;
    }
#if A_T
    const uint ldA = p.lda != 0u ? p.lda : p.M;
#else
    const uint ldA = p.lda != 0u ? p.lda : p.K;
#endif
#if B_T
    const uint ldB = p.ldb != 0u ? p.ldb : p.K;
#else
    const uint ldB = p.ldb != 0u ? p.ldb : p.N;
#endif
#if NF4_B
    // workgroup-uniform, and before any barrier: a tile past its expert's rows has
    // nothing to do, and a group whose rows or weight lie outside what the host
    // sized, whose rows the grid does not cover, or whose weight base is off a
    // packed word reads and writes nothing
    if (tileRow >= mRows || mRows > p.M || rowStart + mRows < rowStart || rowStart + mRows > p.nf4_rows
        || (wBase & 7u) != 0u || wBase > p.nf4_src_limit || p.N * p.K > p.nf4_src_limit - wBase) return;
    aBase = rowStart * ldA;
    bBase = wBase;
    // every staging slot's member uncached until its first read (gatherB)
    [[unroll]] for (uint i = 0u; i < B_PER; ++i) nf4_m[i] = 0xFFFFFFFFu;
#endif
#if GROUPED
    // workgroup-uniform, and before any barrier: a tile past its expert's rows has
    // nothing to do, and a group whose rows lie outside what the host sized, whose
    // rows the grid does not cover, or whose weight (K rows of ldB) lies past B
    // reads and writes nothing
    if (tileRow >= mRows || mRows > p.M || rowStart + mRows < rowStart || rowStart + mRows > p.g_rows
        || wBase > p.g_b_limit || p.K * ldB > p.g_b_limit - wBase) return;
    aBase = rowStart * ldA;
    bBase = wBase;
#endif
#if !EDGE || COMBINED
    const uint aLd = ldA / 8u;
    const uint bLd = ldB / 8u;
    const uint aVec = aBase / 8u;
    const uint bVec = bBase / 8u;
#endif
#if EDGE && COMBINED
    // workgroup-uniform: this tile lies wholly inside M x N and its operands are uvec4-aligned
    const bool interior = tileRow + BM <= p.M && tileCol + BN <= p.N
        && (ldA & 7u) == 0u && (ldB & 7u) == 0u && (aBase & 7u) == 0u && (bBase & 7u) == 0u
        && (kBegin & 7u) == 0u;
    const uint kFull = kBegin + ((kEnd - kBegin) / BK) * BK;
#if NARROW
    const bool narrow = !interior && tileRow + BM <= p.M && tileCol + BN <= p.N
        && (ldA & 3u) == 0u && (ldB & 3u) == 0u && (aBase & 3u) == 0u && (bBase & 3u) == 0u
        && (kBegin & 3u) == 0u;
#if MASKED
    // (MASKED) a ragged tile takes a masked fast loop when each of its reads lies
    // wholly inside or wholly outside the extent: always along a stored row that
    // is one m or one n, and along m (A stored K x M) or n (B stored K x N) when
    // that extent is a multiple of the read's width
    const bool ragged = tileRow + BM > p.M || tileCol + BN > p.N;
#if A_T
    const bool aWhole8 = (p.M & 7u) == 0u;
    const bool aWhole4 = (p.M & 3u) == 0u;
#else
    const bool aWhole8 = true;
    const bool aWhole4 = true;
#endif
#if B_T
    const bool bWhole8 = true;
    const bool bWhole4 = true;
#else
    const bool bWhole8 = (p.N & 7u) == 0u;
    const bool bWhole4 = (p.N & 3u) == 0u;
#endif
    const bool maskedWide = ragged && aWhole8 && bWhole8
        && (ldA & 7u) == 0u && (ldB & 7u) == 0u && (aBase & 7u) == 0u && (bBase & 7u) == 0u
        && (kBegin & 7u) == 0u;
    const bool maskedNarrow = ragged && !maskedWide && aWhole4 && bWhole4
        && (ldA & 3u) == 0u && (ldB & 3u) == 0u && (aBase & 3u) == 0u && (bBase & 3u) == 0u
        && (kBegin & 3u) == 0u;
#endif
#endif
#endif

    coopmat<float32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc[FM][FN];
    for (uint i = 0; i < FM; ++i)
        for (uint j = 0; j < FN; ++j)
            acc[i][j] = coopmat<float32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

#if EDGE && COMBINED
#if NARROW
    if (interior) {
        KLOOP(A_TILE_AL, B_TILE_AL, kBegin, kFull)
        if (kFull < kEnd) {
            KLOOP(A_TILE_G, B_TILE_G, kFull, kEnd)
        }
    } else if (narrow) {
        KLOOP(A_TILE_NA, B_TILE_NA, kBegin, kFull)
        if (kFull < kEnd) {
            KLOOP(A_TILE_G, B_TILE_G, kFull, kEnd)
        }
    } else {
#if MASKED
        uint kGather = kBegin;
        if (maskedWide) {
            KLOOP(A_TILE_ALM, B_TILE_ALM, kBegin, kFull)
            kGather = kFull;
        } else if (maskedNarrow) {
            KLOOP(A_TILE_NAM, B_TILE_NAM, kBegin, kFull)
            kGather = kFull;
        }
        KLOOP(A_TILE_G, B_TILE_G, kGather, kEnd)
#else
        KLOOP(A_TILE_G, B_TILE_G, kBegin, kEnd)
#endif
    }
#else
    if (interior) {
        KLOOP(A_TILE_AL, B_TILE_AL, kBegin, kFull)
        if (kFull < kEnd) {
            KLOOP(A_TILE_G, B_TILE_G, kFull, kEnd)
        }
    } else {
        KLOOP(A_TILE_G, B_TILE_G, kBegin, kEnd)
    }
#endif
#else
#if PREFETCH
    // The uvec4 at panel row `row`, column `col` of the K tile at `k`. It is
    // the same read as the staging loop below, done one tile ahead.
#if EDGE
#if A_T
#define A_TILE(row, col, k) gatherA((k) + (row), kEnd, tileRow + (col) * 8u, p.M, ldA)
#else
#define A_TILE(row, col, k) gatherA(tileRow + (row), M_ROWS, (k) + (col) * 8u, kEnd, ldA)
#endif
#if NF4_B
// (NF4_B) B_TILE is expanded only inside the loops over the B staging slots, and
// their index `i` is the slot whose member gatherB caches
#if B_T
#define B_TILE(row, col, k) gatherB(i, tileCol + (row), p.N, (k) + (col) * 8u, kEnd, ldB)
#else
#define B_TILE(row, col, k) gatherB(i, (k) + (row), kEnd, tileCol + (col) * 8u, p.N, ldB)
#endif
#elif B_T
#define B_TILE(row, col, k) gatherB(tileCol + (row), p.N, (k) + (col) * 8u, kEnd, ldB)
#else
#define B_TILE(row, col, k) gatherB((k) + (row), kEnd, tileCol + (col) * 8u, p.N, ldB)
#endif
#else
#if A_T
#define A_TILE(row, col, k) a[aVec + ((k) + (row)) * aLd + (tileRow / 8u) + (col)]
#else
#define A_TILE(row, col, k) a[aVec + (tileRow + (row)) * aLd + ((k) / 8u) + (col)]
#endif
#if B_T
#define B_TILE(row, col, k) b[bVec + (tileCol + (row)) * bLd + ((k) / 8u) + (col)]
#else
#define B_TILE(row, col, k) b[bVec + ((k) + (row)) * bLd + (tileCol / 8u) + (col)]
#endif
#endif
    uvec4 ra[A_PER];
    uvec4 rb[B_PER];
    // workgroup-uniform; a K-split whose range is empty reads nothing
    if (kBegin < kEnd) {
        [[unroll]] for (uint i = 0u; i < A_PER; ++i) {
            const uint v = tid + i * WG;
            ra[i] = A_TILE(v / A_VEC_PER_ROW, v % A_VEC_PER_ROW, kBegin);
        }
        [[unroll]] for (uint i = 0u; i < B_PER; ++i) {
            const uint v = tid + i * WG;
            rb[i] = B_TILE(v / B_VEC_PER_ROW, v % B_VEC_PER_ROW, kBegin);
        }
    }
#endif

    for (uint k0 = kBegin; k0 < kEnd; k0 += BK) {
#if PREFETCH
        [[unroll]] for (uint i = 0u; i < A_PER; ++i) {
            const uint v = tid + i * WG;
            As[(v / A_VEC_PER_ROW) * A_STRIDE + v % A_VEC_PER_ROW] = ra[i];
        }
        [[unroll]] for (uint i = 0u; i < B_PER; ++i) {
            const uint v = tid + i * WG;
            Bs[(v / B_VEC_PER_ROW) * B_STRIDE + v % B_VEC_PER_ROW] = rb[i];
        }
        barrier();
        // the next tile's reads, in flight during this tile's products
        if (k0 + BK < kEnd) {
            [[unroll]] for (uint i = 0u; i < A_PER; ++i) {
                const uint v = tid + i * WG;
                ra[i] = A_TILE(v / A_VEC_PER_ROW, v % A_VEC_PER_ROW, k0 + BK);
            }
            [[unroll]] for (uint i = 0u; i < B_PER; ++i) {
                const uint v = tid + i * WG;
                rb[i] = B_TILE(v / B_VEC_PER_ROW, v % B_VEC_PER_ROW, k0 + BK);
            }
        }
#else
        for (uint v = tid; v < A_VECS; v += WG) {
            const uint row = v / A_VEC_PER_ROW;
            const uint col = v % A_VEC_PER_ROW;
#if EDGE
#if A_T
            As[row * A_STRIDE + col] = gatherA(k0 + row, kEnd, tileRow + col * 8u, p.M, ldA);
#else
            As[row * A_STRIDE + col] = gatherA(tileRow + row, M_ROWS, k0 + col * 8u, kEnd, ldA);
#endif
#else
#if A_T
            As[row * A_STRIDE + col] = a[aVec + (k0 + row) * aLd + (tileRow / 8u) + col];
#else
            As[row * A_STRIDE + col] = a[aVec + (tileRow + row) * aLd + (k0 / 8u) + col];
#endif
#endif
        }
        for (uint v = tid; v < B_VECS; v += WG) {
            const uint row = v / B_VEC_PER_ROW;
            const uint col = v % B_VEC_PER_ROW;
#if EDGE
#if B_T
            Bs[row * B_STRIDE + col] = gatherB(tileCol + row, p.N, k0 + col * 8u, kEnd, ldB);
#else
            Bs[row * B_STRIDE + col] = gatherB(k0 + row, kEnd, tileCol + col * 8u, p.N, ldB);
#endif
#else
#if B_T
            Bs[row * B_STRIDE + col] = b[bVec + (tileCol + row) * bLd + (k0 / 8u) + col];
#else
            Bs[row * B_STRIDE + col] = b[bVec + (k0 + row) * bLd + (tileCol / 8u) + col];
#endif
#endif
        }
        barrier();
#endif
        for (uint kk = 0; kk < BK; kk += 16) {
            coopmat<ELEM, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ma[FM];
            coopmat<ELEM, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> mb[FN];
            for (uint i = 0; i < FM; ++i) {
                const uint r0 = sgRow * TM + i * 16;
#if A_T
                coopMatLoad(ma[i], As, kk * A_STRIDE + r0 / 8u, A_STRIDE, gl_CooperativeMatrixLayoutColumnMajor);
#else
                coopMatLoad(ma[i], As, r0 * A_STRIDE + kk / 8u, A_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#endif
            }
            for (uint j = 0; j < FN; ++j) {
                const uint c0 = sgCol * TN + j * 16;
#if B_T
                coopMatLoad(mb[j], Bs, c0 * B_STRIDE + kk / 8u, B_STRIDE, gl_CooperativeMatrixLayoutColumnMajor);
#else
                coopMatLoad(mb[j], Bs, kk * B_STRIDE + c0 / 8u, B_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#endif
            }
            for (uint i = 0; i < FM; ++i)
                for (uint j = 0; j < FN; ++j)
                    acc[i][j] = coopMatMulAdd(ma[i], mb[j], acc[i][j]);
        }
        barrier();
    }
#endif
#if EDGE || BF16_OUT
    // UNROLLED, and it has to be (2026-09-23): with this loop body the
    // compiler left the loops rolled, so acc[i][j] was indexed at run time and
    // the accumulators lived in addressable memory for the WHOLE kernel, main
    // loop included. On an NVIDIA L4 that made every edge module 3.7-4.2x
    // slower than the aligned one AT AN ALIGNED SHAPE (8.6 against 36.1
    // TFLOPS at 4096 x 3584 x 512); unrolled, 34.1. The aligned epilogue's
    // one-line body was always unrolled.
    [[unroll]] for (uint i = 0; i < FM; ++i) {
        [[unroll]] for (uint j = 0; j < FN; ++j) {
            // subgroup-uniform: tileRow/tileCol/sgRow/sgCol/i/j and p.M/p.N are
            // all uniform here, so the whole scope instance takes one branch,
            // which is what the cooperative-matrix spec requires
            const uint r0 = tileRow + sgRow * TM + i * 16;
            const uint c0 = tileCol + sgCol * TN + j * 16;
#if BF16_OUT
#if ELEM_F16
            if (r0 + 16u <= M_ROWS && c0 + 16u <= p.N && (p.N & 7u) == 0u && (cBase & 7u) == 0u) {
                // an interior fragment: rounded in registers and stored whole (the note above)
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> h;
                for (int e = 0; e < h.length(); ++e) h[e] = OUT16H(acc[i][j][e]);
                coopMatStore(h, c16, (cBase + r0 * p.N + c0) >> 1u, p.N >> 1u, gl_CooperativeMatrixLayoutRowMajor);
            } else
#endif
            if (r0 < M_ROWS && c0 < p.N) {
                coopMatStore(acc[i][j], Cs, sg * 256u, 16u, gl_CooperativeMatrixLayoutRowMajor);
                subgroupMemoryBarrierShared();
                subgroupBarrier();
                // pairs of columns: c0 + cc is even and N is even, so the pair
                // is inside the row whenever its first element is
                for (uint t = gl_SubgroupInvocationID * 2u; t < 256u; t += gl_SubgroupSize * 2u) {
                    const uint rr = t >> 4u;
                    const uint cc = t & 15u;
                    if (r0 + rr < M_ROWS && c0 + cc < p.N)
                        c16[(cBase + (r0 + rr) * p.N + c0 + cc) >> 1u] =
                            OUT16(Cs[sg * 256u + t]) | (OUT16(Cs[sg * 256u + t + 1u]) << 16u);
                }
                subgroupMemoryBarrierShared();
                subgroupBarrier();
            }
#else
            if (r0 + 16u <= M_ROWS && c0 + 16u <= p.N && (p.N & 3u) == 0u) {
                coopMatStore(acc[i][j], c, cBase + r0 * p.N + c0, p.N, gl_CooperativeMatrixLayoutRowMajor);
            } else if (r0 < M_ROWS && c0 < p.N) {
                coopMatStore(acc[i][j], Cs, sg * 256u, 16u, gl_CooperativeMatrixLayoutRowMajor);
                subgroupMemoryBarrierShared();
                subgroupBarrier();
                for (uint t = gl_SubgroupInvocationID; t < 256u; t += gl_SubgroupSize) {
                    const uint rr = t >> 4u;
                    const uint cc = t & 15u;
                    if (r0 + rr < M_ROWS && c0 + cc < p.N)
                        c[cBase + (r0 + rr) * p.N + c0 + cc] = Cs[sg * 256u + t];
                }
                // the scratch is reused by the next fragment
                subgroupMemoryBarrierShared();
                subgroupBarrier();
            }
#endif
        }
    }
#else
    for (uint i = 0; i < FM; ++i)
        for (uint j = 0; j < FN; ++j)
            coopMatStore(acc[i][j], c, cBase + (tileRow + sgRow * TM + i * 16) * p.N + tileCol + sgCol * TN + j * 16, p.N, gl_CooperativeMatrixLayoutRowMajor);
#endif
}
