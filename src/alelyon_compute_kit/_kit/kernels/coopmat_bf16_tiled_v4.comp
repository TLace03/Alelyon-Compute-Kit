// Eight consecutive bf16 starting e0 (0..7) elements into the 256-bit window
// lo:hi, as one uvec4. Branch-free on e0: a shift by e0 >> 1 whole words, then
// by a half word when e0 is odd. Element i of the window is the low half of
// word i >> 1 when i is even and the high half when it is odd, so result word r
// holds window elements e0 + 2r and e0 + 2r + 1.
uvec4 funnel8(uvec4 lo, uvec4 hi, uint e0) {
    uvec4 x = lo;
    uvec4 y = hi;
    if ((e0 & 4u) != 0u) {   // two words
        x = uvec4(x.z, x.w, y.x, y.y);
        y = uvec4(y.z, y.w, 0u, 0u);
    }
    if ((e0 & 2u) != 0u) {   // one word
        x = uvec4(x.y, x.z, x.w, y.x);
        y = uvec4(y.y, y.z, y.w, 0u);
    }
    if ((e0 & 1u) != 0u) {   // half a word
        x = (x >> 16u) | (uvec4(x.y, x.z, x.w, y.x) << 16u);
    }
    return x;
}

// Eight consecutive bf16 as one uvec4, so `ld` and the z offset may be any
// value. `row` indexes the STORED layout and `ld` is its pitch in ELEMENTS; the
// eight columns start at `col0`. Anything at or past `rowLimit`/`colLimit` is
// exact zero. A whole group reads the uvec4 holding its first element and, when
// it does not start one, the next; the uvec4 view's length is the bound range
// in whole uvec4, so a group that ends inside a final partial one, and a tail
// of fewer than eight, take the scalar path through the uint view. That path
// reads whole 32-bit words and can touch the high half of the word holding the
// operand's last element; the half is discarded by the `valid` mask, and
// Context::buffer allocates every buffer to a whole word, so the read itself is
// in bounds.
uvec4 gatherA(uint row, uint rowLimit, uint col0, uint colLimit, uint ld) {
    if (row >= rowLimit || col0 >= colLimit) return uvec4(0u);
    const uint valid = min(8u, colLimit - col0);
    const uint base = aBase + row * ld + col0;
    if (valid == 8u) {
        const uint j = base >> 3u;
        const uint e0 = base & 7u;
        if (e0 == 0u) return a[j];
        if ((e0 & 1u) == 0u) {
            const uint q = base >> 1u;
            return uvec4(aw[q], aw[q + 1u], aw[q + 2u], aw[q + 3u]);
        }
        if (j + 1u < uint(a.length())) return funnel8(a[j], a[j + 1u], e0);
    }
    uvec4 r = uvec4(0u);
    for (uint e = 0u; e < valid; ++e) {
        const uint idx = base + e;
        const uint w = aw[idx >> 1u];
        const uint h = ((idx & 1u) == 0u) ? (w & 0xFFFFu) : (w >> 16u);
        r[e >> 1u] |= h << (16u * (e & 1u));
    }
    return r;
}

#if NF4_B
#if NF4_HW
// the device's own f32 -> f16 conversion under the float controls declared
// above (to nearest even, subnormals kept): for every value that is not a NaN it
// is convert/v1's routine, which the other fp16 NF4 modules run; a NaN is a NaN
// (NF4_HW, 2026-09-30). Each value is PINNED before it is converted
// (2026-10-01): the RX 9070 XT's driver (26.8.1, LLPC) fused the f32 multiply
// `code * absmax` into the f32 -> f16 conversion, rounding the exact product
// once, even with the multiply decorated NoContraction, where nf4-decode/v1
// rounds it to f32 and then to fp16 (87 of the ABI test's 1,048,576 attention
// weights differed). An integer XOR with a value that is zero at run time (K,
// below 2^31, shifted right 31 places) but not provably so keeps the bits and
// leaves no product to fuse.
float nf4_pinned(float x) { return uintBitsToFloat(floatBitsToUint(x) ^ (p.K >> 31u)); }
uint nf4_to16(float x) { return packFloat2x16(f16vec2(float16_t(nf4_pinned(x)), float16_t(0.0))) & 0xFFFFu; }
uint nf4_pack2(float lo, float hi) {
    return packFloat2x16(f16vec2(float16_t(nf4_pinned(lo)), float16_t(nf4_pinned(hi))));
}
#else
#if ELEM_F16
// convert/v1's f32 -> f16 routine, verbatim (kernels/convert.comp): round to
// nearest even, NaN -> sign | 0x7E00, as nf4-decode/v1's fp16 module rounds
uint nf4_to16(float x) {
    uint w = floatBitsToUint(x);
    uint sign = (w >> 16u) & 0x8000u;
    uint e = (w >> 23u) & 0xFFu;
    uint m = w & 0x7FFFFFu;
    if (e == 0xFFu) return sign | (m != 0u ? 0x7E00u : 0x7C00u);
    int he = int(e) - 112;
    if (he >= 31) return sign | 0x7C00u;
    if (he <= 0) {
        if (he < -10) return sign;
        uint mf = m | 0x800000u;
        uint shift = uint(14 - he);
        uint q = mf >> shift;
        uint rem = mf & ((1u << shift) - 1u);
        uint half_ulp = 1u << (shift - 1u);
        if (rem > half_ulp || (rem == half_ulp && (q & 1u) != 0u)) q += 1u;
        return sign | q;
    }
    uint h = (uint(he) << 10u) | (m >> 13u);
    uint rem = m & 0x1FFFu;
    if (rem > 0x1000u || (rem == 0x1000u && (h & 1u) != 0u)) h += 1u;
    return sign | h;
}
#else
// round to nearest even, NaN kept quiet: the pointwise family's `narrow`, as
// nf4-decode/v1's bf16 module rounds
uint nf4_to16(float x) {
    const uint bits = floatBitsToUint(x);
    if ((bits & 0x7F800000u) == 0x7F800000u && (bits & 0x007FFFFFu) != 0u) {
        return (bits >> 16u) | 0x0040u;
    }
    const uint lsb = (bits >> 16u) & 1u;
    return (bits + 0x7FFFu + lsb) >> 16u;
}
#endif
uint nf4_pack2(float lo, float hi) { return nf4_to16(lo) | (nf4_to16(hi) << 16u); }
#endif

// the member holding value v of the source: the last start at or below it
uint nf4_member(uint v) {
    uint lo = 0u;
    uint hi = p.nf4_members;
    while (hi - lo > 1u) {
        uint mid = (lo + hi) / 2u;
        if (nf4_starts[2u * mid] <= v) lo = mid; else hi = mid;
    }
    return lo;
}

// Each staging slot's member, cached (2026-09-30). A slot's value index only
// grows from one K tile to the next: with B_T its stored row is fixed and its
// column advances, otherwise its column is fixed and its row advances. So the
// member holding it is the cached one or a later one. A slot's first call
// searches; later calls step forward while the next member starts at or below
// the value. That is the member the search finds (the last start at or below
// the value), so every word is the one before.
uint nf4_m[B_PER];
uint nf4_member_cached(uint slot, uint v) {
    uint m = nf4_m[slot];
    if (m == 0xFFFFFFFFu) {
        m = nf4_member(v);
    } else {
        while (m + 1u < p.nf4_members && nf4_starts[2u * (m + 1u)] <= v) ++m;
    }
    nf4_m[slot] = m;
    return m;
}

// Eight consecutive elements of B's stored layout, decoded from NF4 into the
// 16-bit words nf4-decode/v1 writes, zero outside the operand as gatherB stages
// it. The eight share one packed word and one absmax (the host plan's multiples
// of 8), so the absmax is decoded once. `slot` is the staging slot (B_TILE's
// loop index), whose member is cached. A whole group of eight (2026-09-30) is
// unrolled into two values a word, with no indexed write; a tail keeps the loop.
uvec4 gatherB(uint slot, uint row, uint rowLimit, uint col0, uint colLimit, uint ld) {
    if (row >= rowLimit || col0 >= colLimit) return uvec4(0u);
    const uint valid = min(8u, colLimit - col0);
    const uint v0 = bBase + row * ld + col0;
    const uint s = p.nf4_src_base + v0;
    const uint word = nf4_packed[s >> 3u];
    const uint blk = s >> 6u;
    const uint q = (nf4_absmax_q[blk >> 2u] >> (8u * (blk & 3u))) & 0xFFu;
    precise float scale = nf4_tables[16u + q] * nf4_absmax2[blk >> 8u];
    precise float absmax = scale + nf4_offsets[nf4_member_cached(slot, v0)];
    if (valid == 8u) {
        precise float value[8];
        [[unroll]] for (uint e = 0u; e < 8u; ++e) {
            const uint byte_value = (word >> (8u * (e >> 1u))) & 0xFFu;
            const uint index = (e & 1u) == 0u ? (byte_value >> 4u) : (byte_value & 0xFu);
            value[e] = nf4_tables[index] * absmax;
        }
        return uvec4(nf4_pack2(value[0], value[1]), nf4_pack2(value[2], value[3]),
                     nf4_pack2(value[4], value[5]), nf4_pack2(value[6], value[7]));
    }
    uvec4 r = uvec4(0u);
    for (uint e = 0u; e < valid; ++e) {
        const uint byte_value = (word >> (8u * (e >> 1u))) & 0xFFu;
        const uint index = (e & 1u) == 0u ? (byte_value >> 4u) : (byte_value & 0xFu);
        precise float value = nf4_tables[index] * absmax;
        r[e >> 1u] |= nf4_to16(value) << (16u * (e & 1u));
    }
    return r;
}
