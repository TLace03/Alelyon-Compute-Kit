#version 450
// Milestone-2 kernel, version 4: version 3 plus padded shared-memory panels.
// Measured on v3: fragment loads whose 16 elements are contiguous in shared
// memory (A stored transposed, B stored normally) ran 25-30% faster than loads
// that stride by one BK-long panel row (64 bytes at BK=32), which is the bank
// conflict pattern. Panels whose rows are BK long (A when A_T=0, B when
// B_T=1) get PAD extra uvec4 per row so consecutive fragment rows land on
// different banks. Everything else is version 3.
// Z GRID (2026-09-09, all eight variants): gl_WorkGroupID.z is a batch index
// (zmode 0: A, B and C advance by za, zb, zc ELEMENTS per z) or a K-split
// index (zmode 1: this z owns k in [z*kz, min(K, (z+1)*kz)) and writes its
// PARTIAL product at C + z*zc; the caller sums the partials over z). A single
// product is z = 1 with every z word zero, and takes exactly the path it
// took before. The aligned variants require za and zb to be multiples of 8
// (their operands are read as uvec4) and kz a multiple of BK; the edge
// variants gather element-wise and need neither.
// WORKGROUP ORDER (RAST, 2026-10-01; the aligned modules only). By default
// workgroup (x, y) computes tile column x of tile row y, and the device starts
// workgroups in x-fastest order, so consecutive workgroups walk ONE tile row
// across every column: each reuses that row's band of A, while all of B streams
// past once per tile row. When B is wide that is B read M/BM times from memory.
// -DRAST=G walks G tile rows down one tile column before the next column, so a
// panel of B is reused G times while it is in the cache. Only the map from
// workgroup to tile changes; every tile stages the same K tiles in the same
// order, so every element of C is the same sum, bit for bit, and the registers,
// shared memory and scratch are the aligned module's. Built as SEPARATE module
// sets, so the row-order modules keep their exact bytes; the host takes a
// RAST set only for a grid at least 64 tile columns wide. MEASURED on an RX
// 9070 XT with G = 4 against the row-order module, bf16, device time
// (src/bin/gemm_bench.rs, 2026-10-01, each pair in both orders): f32 C at 2048 x
// 32768 x 1024 1.68-1.94x in all four layouts (nt 51.0 -> 99.1 TFLOPS) and at
// 8192^3 1.22-1.59x; bf16 C 1.08-1.36x (nn and nt); at 32 tile columns 1.02x,
// and an earlier sweep of the same bytes 0.91-1.01x at 32 or fewer, which is
// why the host keeps the row order there. tests/matmul_order_abi.rs times every
// entry and layout on the device.
// LEADING DIMENSIONS (2026-09-09): lda and ldb are the STORED row pitch of A
// and of B in elements (A_T=0: the pitch of A's M rows of K; A_T=1: of its K
// stored rows of M; B_T=0: B's K rows of N; B_T=1: its N rows of K), or 0
// for the logical width, which is what every single-product caller passes.
// A head-interleaved [batch, rows, cols] view (batch stride 64, pitch 512)
// is then read in place through za and lda. The aligned variants need the
// pitch to be a multiple of 8; the edge variants gather.
//   forward   C[M,N] = A[M,K]      . B[K,N]        (A_T=0, B_T=0)
//   grad in   dA     = dC[M,N]     . B[K,N]^T      (A_T=0, B_T=1: B stored N x K)
//   grad w    dW     = A[M,K]^T    . dC[M,N]       (A_T=1, B_T=0: A stored K x M)
// Requirements: M % BM == 0, N % BN == 0, K % BK == 0, every leading
// dimension % 8 == 0, and a subgroup of exactly SGW invocations (required by
// the pipeline).
//
// SUBGROUP WIDTH (2026-09-22). The workgroup is NSG subgroups of SGW
// invocations, and main() places each subgroup's tile by gl_SubgroupID on the
// assumption that there are exactly NSG of them. The same module run at any
// other width has a different number of subgroups per workgroup: at 32 lanes a
// 256-invocation workgroup is 8 subgroups, subgroups 4..7 compute tiles outside
// the 2x2 grid, and the product is wrong with no error. That was measured on an
// NVIDIA L4 (driver 580.173.02, minSubgroupSize = maxSubgroupSize = 32), whose
// driver accepted a pipeline that required 64 and returned a maximum relative
// error of 0.85-1.27 on every aligned variant. So each module is compiled for
// one width and the pipeline requires it; the host picks the set the device's
// subgroup-size range admits. SGW=64 is the default, and those modules keep
// the bytes they had before this define existed. SGW=32 is the set for a
// device whose range excludes 64, built with an SG_ROWS x SG_COLS = 2 x 4
// grid (kernels/build.py says why and what it measured). The interior
// arithmetic is the same: a coopmat fragment belongs to one subgroup whatever
// its width, and every loop below strides by WG or by gl_SubgroupSize.
//
// EDGE=1 lifts every one of those shape requirements except the subgroup size,
// and is compiled as a SEPARATE set of variants so the aligned modules keep
// their exact bytes. It differs in only two places, and the interior arithmetic,
// the shared-memory geometry, the PAD skew and the coopMatLoad/coopMatMulAdd
// sequence are untouched:
//
//   1. Staging gathers eight bf16 starting at ANY element, so a leading
//      dimension or a z offset is an element count rather than a count of
//      8-element groups. The aligned modules' uvec4 view is what quantises
//      those to a multiple of 8: `a[i]` addresses bytes [16i, 16i+16), so a
//      row that starts inside a uvec4 cannot be read with one load. The edge
//      gather reads a group that starts a uvec4 with one load, a group that
//      starts on an even element with four 32-bit loads through a SECOND view
//      of the same binding typed `uint`, and a group that starts on an odd
//      element as the two uvec4 it straddles, funnelling out the 128 bits it
//      needs; the uint view also serves a tail of fewer than eight and an odd
//      group that ends inside the final partial uvec4. (2026-09-23: the first
//      edge modules gathered an odd start element by element; the funnel took
//      a 4096 x 512 x 1607 product from 21.2 to 26.7 TFLOPS on an NVIDIA L4,
//      and an even start was 3-4% faster as four words than as a funnel.)
//      Elements outside the
//      operand are staged as exact zero, which covers the M, N and K tails in
//      one rule. Zero-filling BOTH operands in the K tail is what keeps 0*Inf
//      out of a kept accumulator position.
//   2. The store predicates. coopMatStore cannot be masked per element -- the
//      KHR extension requires every invocation in the scope instance to be
//      active and leaves the component-to-(row,column) mapping
//      implementation-dependent -- so a fragment that crosses M or N is stored
//      to a shared f32 scratch at stride 16 and copied out with ordinary
//      predicated scalar writes. Fragments wholly inside the extent keep the
//      direct store, guarded additionally on N % 4 == 0, which is the alignment
//      OpCooperativeMatrixStoreKHR requires of its stride operand
//      (VUID-RuntimeSpirv-OpCooperativeMatrixLoadKHR-08986: 4*N bytes must be a
//      multiple of 16).
//
// ELEMENT TYPE (2026-09-26). ELEM_F16=1 compiles the same modules with fp16
// operands (float16_t) instead of bf16, for a device whose cooperative
// matrices take fp16 but not bf16: NVIDIA Turing (a Kaggle T4) has fp16 tensor
// cores and no bf16 at all. The type appears only in the two fragment
// declarations below: staging moves raw 16-bit words, exact zero is 0x0000 in
// both formats, and the accumulator and C stay f32, so every rule above holds
// unchanged. ELEM_F16 defaults to 0, and the bf16 modules compile to the bytes
// they had before the define existed (all sixteen checked against the
// manifest). The fp16 modules are the coopmat_f16_* entries in build.py.
//
// BF16 OUTPUT (2026-09-27). BF16_OUT=1 (with EDGE=1, and since 2026-09-28 in the
// aligned modules too) writes C as bf16,
// rounded to nearest even with NaN kept quiet exactly as cast_f32_bf16.comp
// rounds, so a bf16 product needs neither an f32 output block nor a separate
// cast dispatch: every fragment goes through the f32 scratch, and each lane
// rounds and writes pairs. N and the z stride of C are even (the host refuses
// otherwise), so a pair never straddles two rows. Batches only (zmode 0): a
// K-split's partials stay f32. MEASURED motive: a 4096 x 512 x 512 product
// wrote an 8 MB f32 block and re-read it to write 4 MB of bf16, on an RX
// 9070 XT 52-57 us against hipBLASLt's 26-60.
//
// FP16 OUTPUT (2026-09-30). With ELEM_F16=1, BF16_OUT=1 writes C in the
// operands' own type, fp16, rounded by the device's own conversion under
// DECLARED float controls (to nearest even, overflow to infinity, subnormals
// kept): for every value that is not a NaN, the word convert/v1 writes
// (kernels/convert.comp), and a NaN stays a NaN, its sign and payload free. So
// an fp16 product is the fp16 modules' f32 C converted once, as the torch
// adapter did in two dispatches, without the f32 block or the convert dispatch. The
// name BF16_OUT is kept: the bf16 modules preprocess to the text they had, so
// their bytes do not move. An INTERIOR fragment whose rows start on 16 bytes
// (N and C's base multiples of 8) is rounded in registers, component by
// component, and stored whole as an fp16 fragment, two halves a word; only a
// ragged fragment takes the scratch. MEASURED on an RX 9070 XT (2026-09-30), the
// student's head (2048 x 1002 @ 1002 x 151936) took 20.0 ms as the product and
// its conversion. With convert/v1's integer routine inlined here, it took 36.9 ms
// through the scratch and 36.8 ms stored directly: that routine made the module
// spill (736 bytes of scratch against 80). With the device's conversion it took
// 15.3 ms, and the step's mid-size products ran 4.6-7.2x faster.
//
// TWO LOOPS (COMBINED=1, with EDGE=1 and PREFETCH=1; 2026-09-28). The edge
// modules keep a bounds-checked gather inside the prefetch loop, and on an RX
// 9070 XT that costs up to twice the aligned modules' time even on tiles that lie
// wholly inside the extent: an edge build whose prefetch used the aligned loads
// ran at the aligned speed. A per-tile branch INSIDE the loop did not help, and
// the aligned module over the whole tiles followed by the edge module over the
// ragged ones in a second dispatch was SLOWER (the ragged tiles' full K loop
// lands on the critical path after a barrier). So each workgroup picks ONE of
// two whole K loops, uniformly and before the first barrier. A tile wholly
// inside M x N, with pitches, z bases and a K start that are multiples of 8, runs
// the aligned module's loop (uvec4 loads, no gather) over the whole K tiles,
// then one gathered step for a K tail. Every other tile runs the edge loop. Each
// tile is still the same K tiles in the same order, with the same values staged,
// so C is bit for bit the edge loop's. MEASURED (gemm_bench, bf16 C, ms,
// edge -> two loops, the aligned module at the padded shape in brackets):
// 3256 x 512 x 4096 tn 0.245 -> 0.227 [0.201]; 4096 x 3256 x 512 nt 0.225 ->
// 0.197 [0.182]; 4096 x 512 x 3256 nn 0.197 -> 0.147 [0.152]; 4096 x 512 x 512
// nt 0.039 -> 0.031 [0.031]. A pitch of 4 mod 8 (1628) keeps every tile on the
// edge loop, unchanged, unless NARROW is also set (below). Without COMBINED the
// source compiles to the bytes it did before.
//
// NARROW (with COMBINED; 2026-09-28). A third whole loop, for a tile wholly
// inside M x N whose pitches, z bases and K start are multiples of 4 but not all
// of 8. A pitch of 4 mod 8, such as the 1628-wide FFN operands, cannot start a
// uvec4 read. That tile builds each panel uvec4 from two uvec2 reads through a
// third view of each binding, over the whole K tiles, then takes one gathered
// step for a K tail. Each fast loop keeps its own tail step. One gather loop
// shared from a variable start (the whole K range for a ragged tile, the tail
// behind either fast loop) made 4096 x 512 x 3256 nn, whose tiles all take the
// aligned loop, 7-9 us a call slower in the pass. MEASURED in the A3r-X2 pass on
// an RX 9070 XT, us a call, four runs each, two loops -> NARROW: 4096 x 512 x
// 1628 nt 135 -> 87; 4096 x 1628 x 512 nn 189 -> 150; 4096 x 512 x 3256 nn 154
// -> 153. Without NARROW the source compiles to the bytes it did before.
//
// MASKED (with COMBINED and NARROW; 2026-09-29). A ragged tile, one not wholly
// inside M x N, ran the gather loop over its whole K range. It now takes a masked
// fast loop when each of its reads lies wholly inside or wholly outside the
// extent. A read along a stored row that is one m or one n always does. A read
// spanning m (A stored K x M) or n (B stored K x N) does when that extent is a
// multiple of the read's width: 8 for the uvec4 loop, 4 for the uvec2 one. A read
// outside is not made, and zero is staged, as the gather stages it. The tiles
// wholly inside keep their unmasked loops. Masking their reads too, with every
// read in an exec-masked block, made 4096 x 512 x 3256 nn 15 us a call slower. The
// ragged branch shares one gather loop, from `kGather`. MEASURED in the A3r-X2
// pass on an RX 9070 XT, us a call, four runs each, main -> MASKED:
// 3256 x 512 x 4096 tn 238-240 -> 219-220; 4096 x 1628 x 512 nn 147-150 ->
// 112-114; 4096 x 3256 x 512 nt 202-204 -> 196-198. The products whose tiles all
// lie inside are unchanged. Without MASKED the source compiles to the bytes it did
// before.
//
// EDGE=1 reads A and B as whole 32-bit words, so it touches the second half of
// the word holding a final element that sits at an even index. Every buffer is
// allocated to a whole word by Context::buffer for exactly this reason; that
// half is read but never used for its value, so its contents do not matter.
//
// PAD_ALL (2026-09-27). PAD_ALL=1 pads the two panels PAD above leaves
// unpadded too: A when A_T=1 and B when B_T=0, whose rows are BM or BN long
// (256 bytes at 128). The v3 measurement that left them unpadded was an RDNA
// one. On NVIDIA a fragment load that is not along the panel row reads eight
// 16-byte rows per 8x8 block, and a 256-byte pitch puts all eight in the same
// four banks. A Kaggle T4 (session df5200c9, 2026-09-27, 32-lane modules)
// measured nt, whose panels are both padded, at 16.8-22.7 TFLOPS. nn (B
// unpadded) ran at 12.6-15.7, tt (A unpadded) at 5.4-11.1 and tn (both
// unpadded) at 3.8-9.0. A padded row starts 16 bytes further round the banks,
// so the eight rows fall in eight different bank groups.
//
// PREFETCH (2026-09-27). PREFETCH=1 reads each K tile's panels into registers
// one tile ahead. The next tile's global reads are issued before this tile's
// products, so their latency overlaps the cooperative-matrix work instead of
// stalling it. The registers go to the single shared copy after the products'
// barrier. The panels must divide evenly among the workgroup's invocations
// (checked below). The shared geometry and the product sequence are the same
// as without it.
//
// NF4 B (NF4_B=1, with EDGE=1, A_T=0 and PREFETCH, without COMBINED;
// 2026-09-30, nf4-matmul/v1). B is a weight held in bitsandbytes'
// NF4 with double quantisation, read in its STORED form: binding 1 holds the
// packed 4-bit indices (two a byte, the first value in the high nibble),
// binding 3 one map index a block of 64 values, binding 4 one FP32 absmax2 a
// nested block of 256 blocks, binding 5 the 16 code values then the 256 map
// values, binding 6 each member's first value (int64, ascending from 0, on whole
// nested blocks) and binding 7 each member's FP32 offset. B's element (row,
// col) in its stored layout is value bBase + row * ldB + col of that source,
// which starts nf4_src_base values into the buffers. The staging decodes each
// group of eight into exactly the 16-bit words nf4-decode/v1 writes:
//   code[index] * fl(fl(map[q] * absmax2) + offset), every product and sum one
//   FP32 rounding with no fused multiply-add, rounded once to ELEM (convert/v1's
//   fp16 routine; round to nearest even with NaN kept quiet for bf16),
// and stages zero outside the operand as the edge gather does. The z grid is
// GROUPED: binding 8 holds three words a z (a routed expert), its first row in A
// and C, its row count, and its weight's first value in the source; a tile past
// its rows exits before any barrier, M's bounds are that count (M_ROWS), and
// p.M is the grid's largest count. Nothing else changes: the A staging, the
// shared geometry, the coopMatLoad/coopMatMulAdd sequence and the store are the
// edge module's. So each group's C is, bit for bit, the edge module's product
// of its rows and its decoded weight: nf4-decode/v1 followed by the kit's own
// product, every variant of which stages the same values in the same K order.
// The host requires ldB to be a multiple of 8, and a group whose weight base
// is not one reads and writes nothing, so a group of eight is always one packed
// word under one absmax. Nor does a group of more rows than p.M (the grid covers
// p.M), whose product would otherwise be written in part. Without NF4_B the
// source compiles to the bytes it did before.
//
// NF4 B WITH A 16-BIT C (NF4_B=1 with BF16_OUT=1; 2026-10-01). C is written in
// the operands' own type by the BF16_OUT epilogue above, unchanged: bf16 rounded
// as cast_f32_bf16.comp rounds, fp16 by the device's own conversion under the
// declared float controls. That epilogue already bounds by M_ROWS and addresses
// from cBase, which under NF4_B are the group's row count and its first row of
// C, as the f32 store's are. So each group's C is the f32 C above rounded once:
// nf4-decode/v1 followed by the kit's 16-bit-output product, bit for bit
// (a NaN a NaN), without the f32 block and the conversion dispatch the torch
// adapter otherwise runs. The host requires N to be even, so a pair of C never
// straddles two rows, and the group's first element of C, rowStart * N, is
// even too.
//
// DENSE GROUPED (GROUPED=1, with EDGE=1, A_T=0, B_T=0, PREFETCH=1 and
// BF16_OUT=1, without COMBINED, NF4_B or ELEM_F16; 2026-10-02, moe-grouped/v1,
// AKV MoE increment M2). NF4_B's grouped z grid with B read DENSE (bf16), for
// the expert-routed layer's gate/up product. Binding 3 holds three words a z (a
// routed expert): its first row in A and C, its row count, and its weight's
// first element in B. That is the table moe-schedule/v1 writes (src/moe_ops.rs),
// with A the schedule's rows gathered by moe-gather/v1. A tile past its rows
// exits before any barrier, M's bounds are that count (M_ROWS), p.M is the
// grid's largest count, and a group whose rows lie past p.g_rows or whose
// weight lies past p.g_b_limit reads and writes nothing. The host keeps K*ldB,
// rows*ldA and rows*N below 2^31 (GroupedGeometry::validate), so these products
// cannot wrap; ldA = K and ldB = N (the host sends lda = ldb = 0). A table
// entry is device data, so rowStart + mRows has its own wrap check. Nothing
// else changes:
// the A and B staging, the shared geometry, the coopMatLoad/coopMatMulAdd
// sequence and the bf16 store are the edge module's. So each group's C is, bit
// for bit, the single-entry product of its rows and its weight (plan Amendment
// 5: every variant stages the same values in the same K order). Without GROUPED
// the source compiles to the bytes it did before.
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#ifndef ELEM_F16
#define ELEM_F16 0
#endif
#if ELEM_F16
// float16_t is declared by GL_EXT_shader_explicit_arithmetic_types, above
#define ELEM float16_t
#else
#extension GL_EXT_bfloat16 : require
#define ELEM bfloat16_t
#endif
#extension GL_EXT_control_flow_attributes : require

#ifndef BM
#define BM 128
#endif
#ifndef BN
#define BN 128
#endif
#ifndef BK
#define BK 32
#endif
#ifndef SG_ROWS
#define SG_ROWS 2
#endif
#ifndef SG_COLS
#define SG_COLS 2
#endif
#ifndef A_T
#define A_T 0
#endif
#ifndef B_T
#define B_T 0
#endif
#ifndef PAD
#define PAD 1
#endif
#ifndef EDGE
#define EDGE 0
#endif
#ifndef SGW
#define SGW 64
#endif
#ifndef BF16_OUT
#define BF16_OUT 0
#endif
#ifndef PAD_ALL
#define PAD_ALL 0
#endif
#ifndef NF4_HW
#define NF4_HW 0
#endif
#if ELEM_F16 && (BF16_OUT || NF4_HW)
// The fp16-output modules round with the device's own f32 -> f16 conversion,
// so its rounding is DECLARED (SPV_KHR_float_controls): to nearest even,
// subnormals kept. These are the 16-bit modes; build.py adds their 64-bit
// twins, which a device whose float controls are only 32-bit independent
// requires, and which glslang cannot declare beside these (it keeps one
// declaration a mode). The host builds these modules only on a device that
// reports all four (ffi.rs, matmul_f16_out_kernels). The fp16 NF4 modules that
// round each decoded weight with the same conversion (NF4_HW, 2026-09-30)
// declare the same modes.
#extension GL_EXT_spirv_intrinsics : require
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4467], 4462, 16);
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4464], 4459, 16);
#endif
#ifndef PREFETCH
#define PREFETCH 0
#endif
#ifndef NF4_B
#define NF4_B 0
#endif
#if NF4_B && (!EDGE || A_T || COMBINED || !PREFETCH)
#error NF4_B is built with EDGE=1, A_T=0 and PREFETCH=1, without COMBINED
#endif
#if NF4_HW && !(NF4_B && ELEM_F16)
#error NF4_HW is a variant of the fp16 NF4 modules
#endif
#ifndef RAST
#define RAST 0
#endif
#if RAST && (EDGE || NF4_B || SGW != 64)
#error RAST (the WORKGROUP ORDER note) is built into the 64-lane aligned modules only, where it was measured
#endif
#ifndef GROUPED
#define GROUPED 0
#endif
#if GROUPED && (!EDGE || A_T || B_T || COMBINED || NF4_B || ELEM_F16 || !PREFETCH || !BF16_OUT)
#error GROUPED (the DENSE GROUPED note) is built with EDGE=1, A_T=0, B_T=0, PREFETCH=1 and BF16_OUT=1, without COMBINED, NF4_B or ELEM_F16
#endif

#if NF4_B || GROUPED
#define M_ROWS mRows
#else
#define M_ROWS p.M
#endif
#define NSG (SG_ROWS * SG_COLS)
#define WG (NSG * SGW)
#define TM (BM / SG_ROWS)
#define TN (BN / SG_COLS)
#define FM (TM / 16)
#define FN (TN / 16)

// staged panel geometry in uvec4 (8 bf16) units, as stored in memory;
// *_VEC_PER_ROW is the useful width, *_STRIDE the padded shared stride
#if A_T
#define A_ROWS BK
#define A_VEC_PER_ROW (BM / 8)
#if PAD_ALL
#define A_STRIDE (A_VEC_PER_ROW + PAD)
#else
#define A_STRIDE A_VEC_PER_ROW
#endif
#else
#define A_ROWS BM
#define A_VEC_PER_ROW (BK / 8)
#define A_STRIDE (A_VEC_PER_ROW + PAD)
#endif
#if B_T
#define B_ROWS BN
#define B_VEC_PER_ROW (BK / 8)
#define B_STRIDE (B_VEC_PER_ROW + PAD)
#else
#define B_ROWS BK
#define B_VEC_PER_ROW (BN / 8)
#if PAD_ALL
#define B_STRIDE (B_VEC_PER_ROW + PAD)
#else
#define B_STRIDE B_VEC_PER_ROW
#endif
#endif
#define A_VECS (A_ROWS * A_VEC_PER_ROW)
#define B_VECS (B_ROWS * B_VEC_PER_ROW)
#if PREFETCH
#if (A_VECS % WG) != 0 || (B_VECS % WG) != 0
#error PREFETCH needs each panel to divide evenly among the workgroup's invocations
#endif
#define A_PER (A_VECS / WG)
#define B_PER (B_VECS / WG)
#endif

layout(local_size_x = WG, local_size_y = 1, local_size_z = 1) in;
#if EDGE
// Two views of each operand at one binding: uvec4 for the staging loads, uint
// for the scalar tail. Aliasing a binding with compatible types is valid SPIR-V
// and valid Vulkan; both views are read-only.
layout(std430, set = 0, binding = 0) readonly buffer A { uvec4 a[]; };
layout(std430, set = 0, binding = 0) readonly buffer Aw { uint aw[]; };
#if NF4_B
layout(std430, set = 0, binding = 1) readonly buffer Nf4Packed { uint nf4_packed[]; };
layout(std430, set = 0, binding = 3) readonly buffer Nf4AbsmaxQ { uint nf4_absmax_q[]; };
layout(std430, set = 0, binding = 4) readonly buffer Nf4Absmax2 { float nf4_absmax2[]; };
layout(std430, set = 0, binding = 5) readonly buffer Nf4Tables { float nf4_tables[]; };
layout(std430, set = 0, binding = 6) readonly buffer Nf4Starts { uint nf4_starts[]; };
layout(std430, set = 0, binding = 7) readonly buffer Nf4Offsets { float nf4_offsets[]; };
layout(std430, set = 0, binding = 8) readonly buffer Nf4Groups { uint nf4_groups[]; };
#else
layout(std430, set = 0, binding = 1) readonly buffer B { uvec4 b[]; };
layout(std430, set = 0, binding = 1) readonly buffer Bw { uint bw[]; };
#endif
#if GROUPED
layout(std430, set = 0, binding = 3) readonly buffer MoeGroups { uint moe_groups[]; };
#endif
